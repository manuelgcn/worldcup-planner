<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <meta name="description" content="Golazo: planificá el Mundial 2026 de punta a punta. Fixture, simulación, bracket, ranking y notificaciones."/>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin/>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&display=swap"/>
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <link rel="stylesheet" href="app.css"/>
    <link rel="stylesheet" href="WorldCupPlanner.UI.styles.css"/>
    <link rel="icon" type="image/svg+xml" href="img/golazo-mark.svg"/>
    <link rel="icon" type="image/png" href="favicon.png"/>
    <link rel="apple-touch-icon" href="img/apple-touch-icon.png"/>
    <meta name="theme-color" content="#0E4D2C"/>
    <meta name="color-scheme" content="light"/>
    @* Bloqueante a propósito y después de los dos meta que actualiza: elige el tema antes de pintar. *@
    <script src="theme.js"></script>
    @* Sin prerender: Routes necesita leer sessionStorage (JS) antes de mostrar la primera página. *@
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)"/>
</head>

<body>
<Routes @rendermode="new InteractiveServerRenderMode(prerender: false)"/>

@* Se ve mientras baja Blazor, conecta y Routes restaura la sesión; el CSS lo oculta cuando aparece .page. *@
<div class="app-loader" role="status">
    <img src="img/golazo-mark.svg" alt="" width="64" height="64"/>
    <span class="app-loader-track" aria-hidden="true"></span>
    <p>Entrando en calor…</p>
</div>

@* Blazor solo le cambia la clase a este id: components-reconnect-show, -failed o -rejected. *@
<div id="components-reconnect-modal" role="alert">
    <div class="m26-card reconnect-card">
        <p class="reconnect-title">Se cortó la conexión.</p>
        <p class="reconnect-retrying">Reintentando…</p>
        <span class="app-loader-track reconnect-retrying" aria-hidden="true"></span>
        <p class="reconnect-lost">No pudimos reconectar. Recargá la página para seguir.</p>
        <button type="button" class="btn btn-primary reconnect-lost" data-reload>
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
            Recargar
        </button>
    </div>
</div>

<script src="export-download.js"></script>
<script src="reconnect.js"></script>
<script src="_framework/blazor.web.js"></script>
</body>

</html>
