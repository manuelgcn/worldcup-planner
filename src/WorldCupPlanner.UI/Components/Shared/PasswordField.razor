@using System.Text.RegularExpressions

@* Campo de contraseña: etiqueta, botón para verla, aviso de Bloq Mayús y, con ShowRules, la lista de
   requisitos que se va tildando al escribir. Uso: <PasswordField Id="..." Label="..."
   Autocomplete="new-password" @bind-Value="password" ShowRules="true" />. *@
<div class="password-field mb-3">
    <label class="form-label" for="@Id">@Label</label>
    <div class="password-input">
        @* data-caps-hint: password.js escribe el aviso en ese párrafo (Blazor no ve el estado de Bloq Mayús).
           @bind y no value + @oninput: así el servidor no reescribe el campo en cada tecla; con demora de
           red esa reescritura pisaba lo que se acababa de escribir. *@
        <input id="@Id" class="form-control" type="@(visible ? "text" : "password")" autocomplete="@Autocomplete"
               placeholder="@Placeholder" spellcheck="false" autocapitalize="off"
               aria-describedby="@DescribedBy" data-caps-hint="@CapsHintId"
               @bind:get="Value" @bind:set="SetValue" @bind:event="oninput" />
        @* password.js cancela su mousedown: al hacer clic el foco sigue en el campo. *@
        <button type="button" class="password-toggle" aria-label="@ToggleLabel" title="@ToggleLabel"
                aria-pressed="@(visible ? "true" : "false")" @onclick="Toggle">
            <i class="bi @(visible ? "bi-eye-slash-fill" : "bi-eye-fill")" aria-hidden="true"></i>
        </button>
    </div>
    <p id="@CapsHintId" class="password-caps" role="status" data-text="@CapsLockMessage"></p>
    @if (ShowRules)
    {
        <ul id="@RulesId" class="password-rules" aria-label="@RulesLabel">
            @foreach ((string text, bool met) in Rules)
            {
                <li class="@(met ? "met" : "")">
                    <i class="bi @(met ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></i>
                    @text<span class="visually-hidden">: @(met ? RuleMetText : RuleMissingText).</span>
                </li>
            }
        </ul>
    }
</div>

@code {
    private const string Placeholder = "••••••••";
    private const string ToggleLabel = "Mostrar contraseña";
    private const string CapsLockMessage = "Bloq Mayús está activado.";
    private const string RulesLabel = "Requisitos de la contraseña";
    private const string RuleMetText = "cumplido";
    private const string RuleMissingText = "falta";
    private const string LengthRule = "Entre 8 y 128 caracteres";
    private const string UppercaseRule = "Una mayúscula";
    private const string LowercaseRule = "Una minúscula";
    private const string DigitRule = "Un número";
    private const string SymbolRule = "Un símbolo, como ! ? @ #";
    // Los mismos límites que valida User.ValidatePassword; acá solo guían mientras se escribe.
    private const int MinLength = 8;
    private const int MaxLength = 128;

    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string Autocomplete { get; set; } = "current-password";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool ShowRules { get; set; }

    private bool visible;

    private string CapsHintId => $"{Id}CapsLock";
    private string RulesId => $"{Id}Rules";
    private string DescribedBy => ShowRules ? $"{RulesId} {CapsHintId}" : CapsHintId;

    // Las mismas expresiones que User.ValidatePassword: solo cuentan las letras A-Z y a-z sin acento.
    private (string Text, bool Met)[] Rules
    {
        get
        {
            string password = Value ?? "";
            return new[]
            {
                (LengthRule, password.Length is >= MinLength and <= MaxLength),
                (UppercaseRule, Regex.IsMatch(password, "[A-Z]")),
                (LowercaseRule, Regex.IsMatch(password, "[a-z]")),
                (DigitRule, Regex.IsMatch(password, "[0-9]")),
                (SymbolRule, Regex.IsMatch(password, "[^a-zA-Z0-9]"))
            };
        }
    }

    private Task SetValue(string? value) => ValueChanged.InvokeAsync(value ?? "");

    private void Toggle() => visible = !visible;
}
