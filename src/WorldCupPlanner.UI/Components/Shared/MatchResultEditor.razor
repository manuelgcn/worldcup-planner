@using WorldCupPlanner.Domain
@using WorldCupPlanner.Domain.Exceptions
@using WorldCupPlanner.Services.DTOs
@using WorldCupPlanner.Services.Exceptions
@using WorldCupPlanner.Services.Interfaces
@inject IMatchService MatchService
@inject IStadiumService StadiumService
@inject SessionState Session

<div class="match-result-editor">
    @if (editorErrors.Any())
    {
        <div class="alert alert-error" role="alert">
            <ul class="mb-0">
                @foreach (string error in editorErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    @if (ShowDateAndStadium)
    {
        <div class="editor-row">
            <label class="form-label" for="editDate-@Match.MatchId">Fecha</label>
            <input id="editDate-@Match.MatchId" class="form-control" type="datetime-local" @bind="matchDate" />
            <label class="form-label" for="editStadium-@Match.MatchId">Estadio</label>
            <select id="editStadium-@Match.MatchId" class="form-select" @bind="stadiumId">
                <option value="0">-- Seleccione estadio --</option>
                @foreach (WorldCupPlanner.Domain.Stadium stadium in stadiums)
                {
                    <option value="@stadium.Id">@stadium.Name</option>
                }
            </select>
        </div>
    }

    <div class="editor-row editor-score">
        <span class="editor-team">@HomeName</span>
        <input class="form-control goal-input" type="number" min="0" @bind="homeGoals" aria-label="Goles de @HomeName" />
        <span class="score-separator">-</span>
        <input class="form-control goal-input" type="number" min="0" @bind="awayGoals" aria-label="Goles de @AwayName" />
        <span class="editor-team">@AwayName</span>
    </div>

    @if (AsksToRegisterPendingScore)
    {
        <div class="form-check">
            <input id="registerScore-@Match.MatchId" class="form-check-input darker-border-checkbox" type="checkbox" @bind="registerPendingScore" />
            <label class="form-check-label" for="registerScore-@Match.MatchId">
                Registrar este marcador como resultado final
            </label>
        </div>
    }

    @if (CanEditIncidents)
    {
        <details class="editor-incidents" open="@incidents.Any()">
            <summary>
                Incidencias (tarjetas) —
                🟨 @HomeName: @CountByType(Match.HomeTeam!.Id, MatchIncidentDto.YellowCardType)
                🟥 @CountByType(Match.HomeTeam!.Id, MatchIncidentDto.RedCardType) |
                🟨 @AwayName: @CountByType(Match.AwayTeam!.Id, MatchIncidentDto.YellowCardType)
                🟥 @CountByType(Match.AwayTeam!.Id, MatchIncidentDto.RedCardType)
            </summary>

            <div class="incidents-grid">
                <div class="incident-item">
                    <label class="form-label" for="incTeam-@Match.MatchId">Equipo</label>
                    <select id="incTeam-@Match.MatchId" class="form-select" @bind="newIncidentTeamId">
                        <option value="@Match.HomeTeam!.Id">@HomeName</option>
                        <option value="@Match.AwayTeam!.Id">@AwayName</option>
                    </select>
                </div>
                <div class="incident-item">
                    <label class="form-label" for="incType-@Match.MatchId">Tipo</label>
                    <select id="incType-@Match.MatchId" class="form-select" @bind="newIncidentType">
                        <option value="@MatchIncidentDto.YellowCardType">🟨 Amarilla</option>
                        <option value="@MatchIncidentDto.RedCardType">🟥 Roja</option>
                    </select>
                </div>
                <div class="incident-item">
                    <label class="form-label" for="incMinute-@Match.MatchId">Minuto</label>
                    <input id="incMinute-@Match.MatchId" class="form-control card-input" type="number" min="0" max="130" @bind="newIncidentMinute" />
                </div>
                <div class="incident-item incident-actions">
                    <button class="btn btn-outline-primary btn-sm" @onclick="AddIncident">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        Agregar
                    </button>
                </div>
            </div>

            @if (incidents.Any())
            {
                <ul class="incident-list list-unstyled mb-0">
                    @foreach (MatchIncidentDto incident in incidents.OrderBy(i => i.Minute))
                    {
                        <li class="incident-row">
                            <span>@CardEmoji(incident.Type) @incident.TeamName — min @incident.Minute</span>
                            <button class="btn btn-outline-danger btn-sm"
                                    title="Eliminar incidencia"
                                    aria-label="Eliminar incidencia"
                                    @onclick="() => RemoveIncident(incident.Id)">
                                <i class="bi bi-trash" aria-hidden="true"></i>
                            </button>
                        </li>
                    }
                </ul>
            }
        </details>
    }

    <div class="editor-actions">
        <button class="btn btn-success btn-sm" @onclick="SaveAsync">
            <i class="bi bi-check-lg" aria-hidden="true"></i>
            Guardar
        </button>
        <button class="btn btn-outline-secondary btn-sm" @onclick="CancelAsync">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
            Cancelar
        </button>
    </div>
</div>

@code {
    private const string ResultSavedMessage = "Resultado guardado correctamente";
    private const string MatchUpdatedMessage = "Partido actualizado correctamente";
    private const string UndecidedTeamName = "A definir";

    [Parameter, EditorRequired] public Match Match { get; set; } = null!;
    [Parameter] public bool ShowDateAndStadium { get; set; }
    [Parameter] public EventCallback<string> OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private DateTime matchDate;
    private int stadiumId;
    private int homeGoals;
    private int awayGoals;

    private List<MatchIncidentDto> incidents = new();
    private int newIncidentTeamId;
    private string newIncidentType = MatchIncidentDto.YellowCardType;
    private int newIncidentMinute;

    private IReadOnlyCollection<WorldCupPlanner.Domain.Stadium> stadiums = Array.Empty<WorldCupPlanner.Domain.Stadium>();
    private readonly List<string> editorErrors = new();

    // Un partido de grupos pendiente muestra 0-0: guardar solo fecha o estadio no debe registrarlo
    // como jugado (sumaba puntos y movía el Elo). Un 0-0 real se confirma con esta casilla.
    private bool registerPendingScore;

    private string HomeName => Match.HomeTeam?.Name ?? UndecidedTeamName;
    private string AwayName => Match.AwayTeam?.Name ?? UndecidedTeamName;
    private bool AsksToRegisterPendingScore => ShowDateAndStadium && Match is not MatchElimination && !Match.HasResult;
    private bool CanEditIncidents => Match.HomeTeam is not null && Match.AwayTeam is not null;
    private string? PerformedByEmail => Session.CurrentUser?.email;

    protected override void OnInitialized()
    {
        matchDate = Match.MatchDate;
        stadiumId = Match.Stadium?.Id ?? 0;
        homeGoals = Match.HomeGoals;
        awayGoals = Match.AwayGoals;

        if (CanEditIncidents)
        {
            newIncidentTeamId = Match.HomeTeam!.Id;
            LoadIncidents();
        }

        if (ShowDateAndStadium)
        {
            stadiums = StadiumService.GetAllStadiums();
        }
    }

    private void LoadIncidents()
    {
        incidents = MatchService.GetIncidents(Match.MatchId);
    }

    private int CountByType(int teamId, string type) =>
        incidents.Count(incident => incident.TeamId == teamId && incident.Type == type);

    private static string CardEmoji(string type) =>
        type == MatchIncidentDto.RedCardType ? "🟥" : "🟨";

    private void AddIncident()
    {
        editorErrors.Clear();

        try
        {
            if (newIncidentType == MatchIncidentDto.RedCardType)
            {
                MatchService.AddRedCard(Match.MatchId, newIncidentTeamId, newIncidentMinute, PerformedByEmail);
            }
            else
            {
                MatchService.AddYellowCard(Match.MatchId, newIncidentTeamId, newIncidentMinute, PerformedByEmail);
            }

            LoadIncidents();
        }
        catch (MatchException ex)
        {
            editorErrors.Add(ex.Message);
        }
        catch (MatchServicesException ex)
        {
            editorErrors.Add(ex.Message);
        }
    }

    private void RemoveIncident(int incidentId)
    {
        editorErrors.Clear();

        try
        {
            MatchService.RemoveIncident(Match.MatchId, incidentId, PerformedByEmail);
            LoadIncidents();
        }
        catch (MatchServicesException ex)
        {
            editorErrors.Add(ex.Message);
        }
    }

    private async Task SaveAsync()
    {
        editorErrors.Clear();

        if (!Validate())
        {
            return;
        }

        try
        {
            // El servicio es el controlador del caso de uso: registra goles, ranking,
            // auditoria y notificacion. La UI solo captura datos y delega.
            // Va antes que la fecha: si el resultado se rechaza (empate en eliminatoria) no queda
            // nada guardado a medias. En eliminatoria un marcador sin cambios no se re-registra:
            // un 0-0 pendiente no es un resultado.
            bool scoreChanged = homeGoals != Match.HomeGoals || awayGoals != Match.AwayGoals;
            bool registersResult = Match is MatchElimination
                ? scoreChanged
                : !AsksToRegisterPendingScore || scoreChanged || registerPendingScore;

            if (registersResult)
            {
                MatchService.RegisterResult(Match.MatchId, homeGoals, awayGoals, PerformedByEmail);
            }

            if (ShowDateAndStadium)
            {
                MatchService.UpdateMatch(Match.MatchId, new UpdateMatchRequestDto
                {
                    MatchDate = matchDate,
                    StadiumId = stadiumId
                });
            }

            await OnSaved.InvokeAsync(registersResult ? ResultSavedMessage : MatchUpdatedMessage);
        }
        catch (MatchException ex)
        {
            editorErrors.Add(ex.Message);
        }
        catch (MatchServicesException ex)
        {
            editorErrors.Add(ex.Message);
        }
        catch (ArgumentException ex)
        {
            editorErrors.Add(ex.Message);
        }
        catch (Exception ex)
        {
            editorErrors.Add("Error al guardar el partido: " + ex.Message);
        }
    }

    private bool Validate()
    {
        if (ShowDateAndStadium && matchDate == default)
        {
            editorErrors.Add("La fecha es obligatoria");
        }

        if (ShowDateAndStadium && stadiumId <= 0)
        {
            editorErrors.Add("Debe seleccionar un estadio");
        }

        if (homeGoals < 0 || awayGoals < 0)
        {
            editorErrors.Add("Los goles no pueden ser negativos");
        }

        return !editorErrors.Any();
    }

    private Task CancelAsync() => OnCancel.InvokeAsync();
}
