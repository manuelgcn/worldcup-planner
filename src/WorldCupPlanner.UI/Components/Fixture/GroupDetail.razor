@using WorldCupPlanner.Domain
@inject NavigationManager Nav

<div class="group-detail">
    <div class="group-detail-head">
        <h4>Grupo @GroupName — Partidos</h4>
        <div class="group-detail-actions">
            <button class="btn btn-secondary" @onclick="HandleBack">Volver</button>
            <button class="btn btn-link" @onclick="NavigateToMatchesPage">Ver en listado de partidos</button>
        </div>
    </div>

    @if (IsLocked)
    {
        <p class="group-detail-locked">
            <i class="bi bi-lock-fill" aria-hidden="true"></i>
            La fase de grupos está cerrada: los cruces de fase 2 ya fueron generados.
        </p>
    }

    @if (Matches.Count == 0)
    {
        <p>No hay partidos persistidos para este grupo.</p>
    }
    else
    {
        @foreach (IGrouping<int, MatchGroup> journey in GroupedByJourney)
        {
            <h5>Jornada @journey.Key</h5>
            <table class="matches-table">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Local</th>
                        <th>Resultado</th>
                        <th>Visitante</th>
                        <th>Estadio</th>
                        <th>Estado</th>
                        @if (ShowEditColumn)
                        {
                            <th></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (MatchGroup match in journey)
                    {
                        <tr>
                            <td>@match.MatchDate.ToString("dd/MM HH:mm")</td>
                            <td><TeamFlag Team="match.HomeTeam" />@match.HomeTeam?.Name</td>
                            <td>
                                <span class="m26-score @(IsPlayed(match) ? "" : "pending")">
                                    @(IsPlayed(match) ? $"{match.HomeGoals} - {match.AwayGoals}" : "vs")
                                </span>
                            </td>
                            <td><TeamFlag Team="match.AwayTeam" />@match.AwayTeam?.Name</td>
                            <td>@match.Stadium?.Name</td>
                            <td>
                                <span class="match-status @(IsPlayed(match) ? "played" : "pending")">
                                    @(IsPlayed(match) ? "Finalizado" : "Pendiente")
                                </span>
                            </td>
                            @if (ShowEditColumn)
                            {
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm"
                                            disabled="@(editingMatchId == match.MatchId)"
                                            @onclick="() => StartEdit(match)">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                        Cargar resultado
                                    </button>
                                </td>
                            }
                        </tr>
                        @if (editingMatchId == match.MatchId && ShowEditColumn)
                        {
                            <tr class="row-editing">
                                <td colspan="@ColumnCount">
                                    <MatchResultEditor Match="match"
                                                       OnSaved="HandleSaved"
                                                       OnCancel="CancelEdit" />
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public string GroupName { get; set; } = "";
    [Parameter, EditorRequired] public List<MatchGroup> Matches { get; set; } = new();
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool IsLocked { get; set; }
    [Parameter] public EventCallback<string> OnResultSaved { get; set; }

    private int? editingMatchId;

    private bool ShowEditColumn => CanEdit && !IsLocked;

    private int ColumnCount => ShowEditColumn ? 7 : 6;

    private IEnumerable<IGrouping<int, MatchGroup>> GroupedByJourney =>
        Matches
            .OrderBy(match => match.Journey?.Number ?? 0)
            .ThenBy(match => match.MatchDate)
            .GroupBy(match => match.Journey?.Number ?? 0);

    private static bool IsPlayed(MatchGroup match) => match.HasResult;

    private Task HandleBack() => OnBack.InvokeAsync();

    private void StartEdit(MatchGroup match)
    {
        editingMatchId = match.MatchId;
    }

    private void CancelEdit()
    {
        editingMatchId = null;
    }

    private async Task HandleSaved(string message)
    {
        editingMatchId = null;
        await OnResultSaved.InvokeAsync(message);
    }

    private void NavigateToMatchesPage()
    {
        Nav.NavigateTo($"/matches?grupo={Uri.EscapeDataString(GroupName)}");
    }
}
