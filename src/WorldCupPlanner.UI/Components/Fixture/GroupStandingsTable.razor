@using WorldCupPlanner.Services.DTOs

<table class="standings-table">
    <thead>
        <tr>
            <th>Equipo</th>
            <th title="Partidos jugados">PJ</th>
            <th title="Ganados">G</th>
            <th title="Empatados">E</th>
            <th title="Perdidos">P</th>
            <th title="Goles a favor">GF</th>
            <th title="Goles en contra">GC</th>
            <th title="Diferencia de gol">DG</th>
            <th>Pts</th>
        </tr>
    </thead>
    <tbody>
        @{
            int position = 0;
        }
        @foreach (GroupStandingDto row in Standings)
        {
            position++;
            int moves = rows[row.Team.Id].Moves;
            <tr @key="(row.Team.Id, moves)" class="@RowClass(position) @(moves > 0 ? "moved" : "")">
                <td class="text-nowrap"><TeamFlag Team="row.Team" />@row.Team.Name</td>
                <td>@row.GamesPlayed</td>
                <td>@row.Wins</td>
                <td>@row.Draws</td>
                <td>@row.Losses</td>
                <td>@row.GoalsFor</td>
                <td>@row.GoalsAgainst</td>
                <td>@row.GoalDifference</td>
                <td><strong>@row.Points</strong></td>
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter] public List<GroupStandingDto> Standings { get; set; } = new();

    // Puesto anterior y cantidad de cambios de puesto de cada equipo. Cuando una fila cambia de
    // puesto, @key la recrea con .moved y el resaltado (Fixture.razor.css) corre una vez; el primer
    // dibujo no resalta nada.
    private Dictionary<int, (int Position, int Moves)> rows = new();

    protected override void OnParametersSet()
    {
        Dictionary<int, (int Position, int Moves)> current = new();
        for (int position = 0; position < Standings.Count; position++)
        {
            int teamId = Standings[position].Team.Id;
            int moves = rows.TryGetValue(teamId, out (int Position, int Moves) previous)
                ? previous.Moves + (previous.Position == position ? 0 : 1)
                : 0;
            current[teamId] = (position, moves);
        }
        rows = current;
    }

    private static string RowClass(int position)
    {
        if (position <= 2) return "qualified";
        if (position == 3) return "third-place";
        return "eliminated";
    }
}
