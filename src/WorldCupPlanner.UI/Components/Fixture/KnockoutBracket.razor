@using WorldCupPlanner.Domain

@if (AllElimMatches.Count == 0)
{
    <p>Aún no se generaron cruces de fase 2.</p>
}
else
{
    @* Vista única y compacta: árbol horizontal R32 → Final con SOLO las
       banderas y el marcador. Pasá el mouse para ver nombres y penales. *@
    <div class="bracket-compact-wrap">
        @if (Champion is not null)
        {
            <div class="bracket-champion">
                <i class="bi bi-trophy-fill" aria-hidden="true"></i>
                <span class="bracket-champion-label">Campeón del mundo</span>
                <TeamFlag Team="Champion" Large="true" />
                <strong>@Champion.Name</strong>
            </div>
        }
        <p class="bracket-hint">Cada llave muestra las banderas de los dos equipos con su resultado. Pasá el mouse para ver nombres y penales.</p>
        <div class="bracket-compact">
            @foreach (BracketColumn column in BuildColumns())
            {
                <div class="bracket-compact-column @column.CssClass">
                    <h6>@column.Title</h6>
                    <div class="bracket-compact-cells">
                        @foreach (MatchElimination match in column.Matches)
                        {
                            <div class="bracket-mini @PlayedClass(match)" title="@MatchTooltip(match)">
                                @* Solo los 16avos tienen códigos legibles (A1…B8); el resto se ve en el tooltip. *@
                                @if (match.Phase == Phase.RoundOf32)
                                {
                                    <span class="bracket-mini-code">@match.MatchCode</span>
                                }
                                <div class="bracket-mini-row @WinnerClass(match, true)">
                                    <TeamFlag Team="match.HomeTeam" />
                                    <span class="bracket-mini-name">@TeamName(match.HomeTeam)</span>
                                    <span class="bracket-mini-score">@ScoreFor(match, true)</span>
                                </div>
                                <div class="bracket-mini-row @WinnerClass(match, false)">
                                    <TeamFlag Team="match.AwayTeam" />
                                    <span class="bracket-mini-name">@TeamName(match.AwayTeam)</span>
                                    <span class="bracket-mini-score">@ScoreFor(match, false)</span>
                                </div>
                            </div>
                        }
                        @if (column.Matches.Count == 0)
                        {
                            <div class="bracket-mini placeholder">Pendiente</div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public List<MatchElimination> AllElimMatches { get; set; } = new();

    private const string NoScorePlaceholder = "–";

    private static readonly (Phase Phase, string Title)[] PhasesInDisplayOrder =
    {
        (Phase.RoundOf32, "R32"),
        (Phase.RoundOf16, "Octavos"),
        (Phase.QuarterFinals, "Cuartos"),
        (Phase.SemiFinal, "Semis"),
        (Phase.ThirdPlace, "3er puesto"),
        (Phase.Final, "Final")
    };

    private Team? Champion =>
        AllElimMatches.FirstOrDefault(match => match.Phase == Phase.Final && match.HasResult)?.GetWinner();

    private IEnumerable<BracketColumn> BuildColumns()
    {
        foreach ((Phase phase, string title) in PhasesInDisplayOrder)
        {
            List<MatchElimination> matches = AllElimMatches
                .Where(match => match.Phase == phase)
                .OrderBy(match => match.MatchId)
                .ToList();
            yield return new BracketColumn(title, matches, $"phase-{phase}");
        }
    }

    private static string PlayedClass(MatchElimination match) => match.HasResult ? "played" : "pending";

    private static string WinnerClass(MatchElimination match, bool isHome)
    {
        if (!match.HasResult) return "";
        Team? winner = match.GetWinner();
        if (winner == null) return "";
        bool isWinner = isHome ? winner == match.HomeTeam : winner == match.AwayTeam;
        return isWinner ? "winner" : "loser";
    }

    private static string ScoreFor(MatchElimination match, bool isHome)
    {
        if (!match.HasResult) return NoScorePlaceholder;
        int goals = isHome ? match.HomeGoals : match.AwayGoals;
        if (match.WonByPenalties)
        {
            int penalties = isHome ? match.HomePenaltyGoals : match.AwayPenaltyGoals;
            return $"{goals} ({penalties})";
        }
        return goals.ToString();
    }

    private static string TeamName(Team? team) => team?.Name ?? "TBD";

    private static string MatchTooltip(MatchElimination match)
    {
        string home = match.HomeTeam?.Name ?? "TBD";
        string away = match.AwayTeam?.Name ?? "TBD";
        if (!match.HasResult)
        {
            return $"{match.MatchCode}: {home} vs {away} (pendiente)";
        }
        string penalties = match.WonByPenalties
            ? $" (pen. {match.HomePenaltyGoals}-{match.AwayPenaltyGoals})"
            : "";
        return $"{match.MatchCode}: {home} {match.HomeGoals}-{match.AwayGoals} {away}{penalties}";
    }

    private sealed record BracketColumn(string Title, List<MatchElimination> Matches, string CssClass);
}
