@page "/fixture"
@using WorldCupPlanner.Domain
@using WorldCupPlanner.Domain.Exceptions
@using WorldCupPlanner.Services
@using WorldCupPlanner.Services.DTOs
@using WorldCupPlanner.Services.Exceptions
@using WorldCupPlanner.Services.Interfaces
@using Microsoft.JSInterop
@using WorldCupPlanner.UI.Components.Fixture
@inject IFixtureOrchestrator FixtureOrchestrator
@inject ISimulationEngineRegistry EngineRegistry
@inject ITournamentSimulationService SimulationService
@inject IGroupStandingsService StandingsService
@inject IKnockoutFixtureGenerator KnockoutGenerator
@inject IFixtureViewService FixtureViewService
@inject ITeamService TeamServices
@inject IStadiumService StadiumService
@inject IExportService ExportService
@inject SessionState Session
@inject IJSRuntime JS
@inject ILogger<Fixture> Logger

<PageTitle>Fixture y cruces · Golazo</PageTitle>

<div class="fixture-page">
    <h1 class="m26-page-title mb-2">
        Fixture y cruces
        @if (Session.IsLoggedIn && settings is not null && IsFixtureGenerated)
        {
            <span class="engine-badge" title="Motor de simulación seleccionado">
                <i class="bi bi-cpu" aria-hidden="true"></i>
                @settings.SelectedSimulationEngine
            </span>
        }
    </h1>

    @if (!Session.IsLoggedIn)
    {
        <LoginRequired />
    }
    else
    {
        <FeedbackAlerts Errors="errors" SuccessMessage="@successMessage" />

        @if (settings is null)
        {
            <div class="alert alert-error">No hay configuración del torneo cargada.</div>
        }
        else
        {
            <div class="wizard-banner @CurrentStep.CssClass">
                <span class="wizard-step-label">Paso @CurrentStep.Number de 4</span>
                <span class="wizard-step-title">@CurrentStep.Title</span>
                <span class="wizard-step-hint">@CurrentStep.Hint</span>
            </div>

            <details class="status-panel">
                <summary>Estado del torneo</summary>
                <div class="status-grid">
                    <div>
                        <strong>Equipos:</strong> @teamCount / @RequiredTeamCount
                        @if (teamCount < RequiredTeamCount)
                        {
                            <span class="status-warn">(faltan @(RequiredTeamCount - teamCount))</span>
                        }
                    </div>
                    <div>
                        <strong>Estadios:</strong> @stadiumCount
                        @if (stadiumCount < MinimumStadiumCount)
                        {
                            <span class="status-warn">(mínimo @MinimumStadiumCount)</span>
                        }
                    </div>
                    <div><strong>Partidos de grupos:</strong> @groupMatches.Count / @GroupStageMatchCount</div>
                    <div><strong>Pendientes (sin simular):</strong> @pendingGroupMatches</div>
                    <div><strong>Eliminatorias generadas:</strong> @(IsKnockoutGenerated ? "sí" : "no")</div>
                    <div><strong>Motor de simulación:</strong> @settings.SelectedSimulationEngine</div>
                </div>
                <details class="status-advanced">
                    <summary>Configuración avanzada (semillas y fechas)</summary>
                    <div class="status-grid">
                        <div><strong>Semilla del sorteo:</strong> @settings.FixtureSeed</div>
                        <div><strong>Semilla de cruces:</strong> @settings.CrossingsSeed</div>
                        <div><strong>Semilla de simulación:</strong> @settings.SimulationSeed</div>
                        <div><strong>Semilla de completado:</strong> @settings.CompletionSeed</div>
                        <div><strong>Fecha de inicio:</strong> @settings.StartDate.ToString("dd/MM/yyyy")</div>
                    </div>
                </details>
            </details>

            @if (CanExport)
            {
                <section class="step-section">
                    <h2>Exportar fixture</h2>
                    <p class="step-help">Descargá los partidos de grupos y eliminatorias dentro del rango seleccionado.</p>
                    <div class="step-actions">
                        <span class="step-field">
                            <label for="exportFixtureFrom">Desde:</label>
                            <input id="exportFixtureFrom" class="form-control" type="date" @bind="exportFromDate" />
                        </span>
                        <span class="step-field">
                            <label for="exportFixtureTo">Hasta:</label>
                            <input id="exportFixtureTo" class="form-control" type="date" @bind="exportToDate" />
                        </span>
                        <span class="step-field">
                            <label for="exportFixtureFormat">Formato:</label>
                            <select id="exportFixtureFormat" class="form-select" @bind="exportFormat">
                                <option value="@ExportFormat.Csv">CSV</option>
                                <option value="@ExportFormat.Xlsx">XLSX</option>
                            </select>
                        </span>
                        <button class="btn btn-outline-primary" disabled="@isExporting" @onclick="HandleExportFixtureAsync">
                            <i class="bi bi-download" aria-hidden="true"></i>
                            Exportar fixture
                        </button>
                    </div>
                </section>
            }

            @* PASO 1: cargar equipos y estadios demo *@
            @if (IsAdmin && !HasBaseData)
            {
                <section class="step-section">
                    <h2>1. Cargar datos base</h2>
                    <p class="step-help">Atajo para tener 48 equipos y 4 estadios sin cargarlos a mano.</p>
                    <div class="step-actions">
                        <button class="btn btn-primary"
                                disabled="@(teamCount >= RequiredTeamCount || isBusy)"
                                @onclick="HandleFillTeamsAsync">
                            @(teamCount >= RequiredTeamCount ? $"✓ {RequiredTeamCount} equipos listos" : $"Cargar {RequiredTeamCount - teamCount} equipos demo")
                        </button>
                        <button class="btn btn-primary"
                                disabled="@(stadiumCount >= MinimumStadiumCount || isBusy)"
                                @onclick="HandleSeedStadiumsAsync">
                            @(stadiumCount >= MinimumStadiumCount ? "✓ Estadios listos" : "Cargar estadios demo")
                        </button>
                    </div>
                </section>
            }

            @* PASO 2: generar fixture *@
            @if (CanManageFixture && HasBaseData && !IsFixtureGenerated)
            {
                <section class="step-section">
                    <h2>2. Generar fixture de fase de grupos</h2>
                    <p class="step-help">Reparte los 48 equipos en 12 grupos y crea los 72 partidos.</p>
                    <div class="step-actions">
                        <span class="step-field">
                            <label for="engineSelect">Motor de simulación:</label>
                            <select id="engineSelect" class="form-select" @bind="selectedEngine">
                                @foreach (string engineName in EngineRegistry.AvailableEngineNames)
                                {
                                    <option value="@engineName">@engineName</option>
                                }
                            </select>
                        </span>
                        <span class="step-field">
                            <label for="fixtureSeedInput">Semilla del sorteo (opcional):</label>
                            <input id="fixtureSeedInput" class="form-control" type="number" @bind="fixtureSeedInput" placeholder="@settings.FixtureSeed.ToString()" />
                        </span>
                        <button class="btn btn-primary" disabled="@isBusy" @onclick="HandleGenerateFixtureAsync">
                            Generar fixture
                        </button>
                    </div>
                </section>
            }

            @* PASO 3: simular grupos o cargar resultados *@
            @if (IsFixtureGenerated && !IsKnockoutGenerated)
            {
                <section class="step-section">
                    <h2>3. Jugar fase de grupos</h2>
                    <p class="step-help">
                        @if (IsGroupStageComplete)
                        {
                            <text>Todos los partidos de grupos están simulados. Podés sortear los cruces de fase 2.</text>
                        }
                        else
                        {
                            <text>Simulá todos los partidos de una sola vez, o cargá los resultados a mano en <a href="/matches">Partidos</a>. Faltan @pendingGroupMatches partidos.</text>
                        }
                    </p>
                    @if (CanManageFixture)
                    {
                        @if (!IsGroupStageComplete)
                        {
                            <div class="step-actions">
                                <span class="step-field">
                                    <label for="simSeedInput">Semilla de simulación (opcional):</label>
                                    <input id="simSeedInput" class="form-control" type="number" @bind="simulationSeedInput" placeholder="@settings.SimulationSeed.ToString()" />
                                </span>
                                <button class="btn btn-primary" disabled="@isBusy" @onclick="HandleSimulateGroupStageAsync">
                                    Simular fase de grupos
                                </button>
                            </div>
                        }
                        <div class="step-actions">
                            <span class="step-field">
                                <label for="crossSeedInput">Semilla de cruces (opcional):</label>
                                <input id="crossSeedInput" class="form-control" type="number" @bind="crossingsSeedInput" placeholder="@settings.CrossingsSeed.ToString()" />
                            </span>
                            <button class="btn btn-primary"
                                    disabled="@(!CanGenerateKnockout || isBusy)"
                                    @onclick="HandleGenerateKnockoutAsync"
                                    title="@GenerateKnockoutTooltip()">
                                Sortear 16avos de final
                            </button>
                            <button class="btn btn-secondary"
                                    disabled="@(IsKnockoutGenerated || isBusy)"
                                    @onclick="StartRegenerateConfirmation"
                                    title="@RegenerateFixtureTooltip()">
                                Regenerar fixture
                            </button>
                        </div>
                        @if (confirmingRegenerate)
                        {
                            <div class="confirm-panel mt-3" role="group" aria-label="Confirmar regeneración del fixture">
                                <p class="confirm-text">
                                    <strong>¿Regenerar el fixture?</strong>
                                    Se borran los partidos de grupos y sus resultados, también los cargados a mano. Esta acción no se puede deshacer.
                                </p>
                                <div class="step-actions">
                                    <button class="btn btn-secondary" disabled="@isBusy" @onclick="CancelRegenerateConfirmation">
                                        Cancelar
                                    </button>
                                    <button class="btn btn-danger" disabled="@isBusy" @onclick="HandleRegenerateFixtureAsync">
                                        Sí, regenerar
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </section>
            }

            @* PASO 4: simular knockout *@
            @if (IsKnockoutGenerated)
            {
                <section class="step-section">
                    <h2>4. Simular bracket eliminatorio</h2>
                    <p class="step-help">
                        @if (IsBracketComplete)
                        {
                            <text>El torneo está completo. ¡Hay campeón!</text>
                        }
                        else
                        {
                            <text>Simulá ronda por ronda, de un saque hasta el final, o avanzá de fase
                            sin simular para cargar los resultados a mano en <a href="/matches">Partidos</a>.</text>
                        }
                    </p>
                    @* Con campeón no queda nada por simular: tres botones apagados solo serían ruido. *@
                    @if (CanManageFixture && !IsBracketComplete)
                    {
                        <div class="step-actions">
                            <button class="btn btn-secondary"
                                    disabled="@isBusy"
                                    @onclick="HandleSimulateNextRoundAsync">
                                Simular siguiente ronda
                            </button>
                            <button class="btn btn-primary"
                                    disabled="@isBusy"
                                    @onclick="HandleSimulateUntilFinalAsync">
                                Simular hasta el final
                            </button>
                            <button class="btn btn-outline-primary"
                                    disabled="@(!CanAdvancePhase || isBusy)"
                                    @onclick="HandleAdvancePhaseAsync"
                                    title="@AdvancePhaseTooltip()">
                                Avanzar de fase (sin simular)
                            </button>
                        </div>
                        @* Un botón deshabilitado no recibe foco: el motivo va como texto visible, no solo en el title. *@
                        @if (!CanAdvancePhase)
                        {
                            <p class="step-help mt-2 mb-0">@AdvancePhaseTooltip()</p>
                        }
                    }
                </section>
            }

            @* SECCIÓN GRUPOS — visible una vez generado el fixture *@
            @if (IsFixtureGenerated)
            {
                <section class="groups-section">
                    <h2>Grupos</h2>
                    <div class="group-chips" role="group" aria-label="Elegir grupo">
                        @foreach (Group group in groups)
                        {
                            <button type="button" class="group-chip @(selectedGroupName == group.Name ? "active" : "")"
                                    aria-label="Grupo @group.Name"
                                    aria-pressed="@(selectedGroupName == group.Name ? "true" : "false")"
                                    @onclick="() => HandleSelectGroup(group.Name)">
                                @group.Name
                            </button>
                        }
                    </div>
                    <div class="groups-grid">
                        @foreach (Group group in groups)
                        {
                            <GroupCard Group="group"
                                       Standings="@standingsByGroup[group.Name]"
                                       OnSelect="HandleSelectGroup" />
                        }
                    </div>
                    <ul class="groups-legend">
                        <li class="legend-qualified">Clasificados (1.º y 2.º)</li>
                        <li class="legend-third">Tercero: compite por los 8 mejores terceros</li>
                    </ul>
                </section>

                @if (selectedGroupName != null)
                {
                    <section class="group-detail-section">
                        <GroupDetail @key="selectedGroupName"
                                     GroupName="@selectedGroupName"
                                     Matches="@MatchesForSelectedGroup()"
                                     OnBack="HandleClearSelection"
                                     CanEdit="@CanEditResults"
                                     IsLocked="@IsKnockoutGenerated"
                                     OnResultSaved="HandleResultSaved" />
                    </section>
                }
            }

            @* SECCIÓN BRACKET — visible una vez sorteados los cruces *@
            @if (IsKnockoutGenerated)
            {
                <section class="bracket-section">
                    <h2>Bracket eliminatorio</h2>
                    <KnockoutBracket AllElimMatches="@eliminationMatches" />
                </section>
            }

            @* ZONA DE REINICIO — borra todo el torneo (grupos + partidos + fase 2) *@
            @if (IsAdmin && IsFixtureGenerated)
            {
                <section class="step-section danger-zone">
                    <h2>Reiniciar torneo</h2>
                    <p class="step-help">
                        Elimina los 12 grupos, los 72 partidos de fase de grupos y, si existen, los cruces de fase 2.
                        Volvés al paso de generación del fixture.
                    </p>
                    @if (!confirmingDelete)
                    {
                        <div class="step-actions">
                            <button class="btn btn-danger" disabled="@isBusy" @onclick="StartDeleteConfirmation">
                                <i class="bi bi-trash3" aria-hidden="true"></i>
                                Borrar fixture
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="confirm-panel" role="group" aria-label="Confirmar borrado del fixture">
                            <p class="confirm-text">
                                <strong>¿Seguro que querés borrar el fixture?</strong>
                                Se eliminan los grupos, los partidos y los cruces de fase 2. Esta acción no se puede deshacer.
                            </p>
                            <div class="step-actions">
                                <button class="btn btn-secondary" disabled="@isBusy" @onclick="CancelDeleteConfirmation">
                                    Cancelar
                                </button>
                                <button class="btn btn-danger" disabled="@isBusy" @onclick="HandleDeleteFixtureAsync">
                                    Sí, borrar todo
                                </button>
                            </div>
                        </div>
                    }
                </section>
            }
        }
    }
</div>

@code {
    private const string UnexpectedErrorMessage =
        "Ocurrió un error inesperado. Revisá el estado del torneo e intentá nuevamente.";
    private const string StandingsLoadErrorMessage =
        "No se pudo cargar la tabla de posiciones del grupo. Intentá nuevamente.";
    // Mismos umbrales que validan FixtureService y StadiumServices; aca solo guian el asistente.
    private const int RequiredTeamCount = 48;
    private const int MinimumStadiumCount = 4;
    private const int GroupStageMatchCount = 72;

    private TournamentSettings? settings;
    private List<Group> groups = new();
    private List<MatchGroup> groupMatches = new();
    private List<MatchElimination> eliminationMatches = new();
    private int teamCount;
    private int stadiumCount;
    private int pendingGroupMatches;
    private string? selectedGroupName;
    private int? fixtureSeedInput;
    private int? crossingsSeedInput;
    private int? simulationSeedInput;
    private string? selectedEngine;
    private bool confirmingDelete;
    private bool confirmingRegenerate;
    private Dictionary<string, List<GroupStandingDto>> standingsByGroup = new();
    private DateTime? exportFromDate;
    private DateTime? exportToDate;
    private ExportFormat exportFormat = ExportFormat.Csv;
    private bool isExporting;

    private readonly List<string> errors = new();
    private string? successMessage;
    private bool isBusy;

    private bool IsAdmin =>
        Session.CurrentUser?.HasRole(UserRoles.Admin) == true;

    // Según la letra, el Editor es quien genera fixture, simula y sortea cruces.
    private bool CanManageFixture =>
        IsAdmin || Session.CurrentUser?.HasRole(UserRoles.Editor) == true;

    private bool CanExport =>
        IsAdmin || Session.CurrentUser?.HasRole(UserRoles.Periodista) == true;

    private bool CanEditResults => CanManageFixture;

    private bool HasBaseData =>
        teamCount >= RequiredTeamCount && stadiumCount >= MinimumStadiumCount;

    // Estado del asistente: las reglas viven en los servicios y se consultan una vez por
    // recarga (ReloadState), no en cada render; cada consulta lee la base.
    private bool IsFixtureGenerated { get; set; }
    private bool IsKnockoutGenerated { get; set; }
    private bool IsGroupStageComplete { get; set; }
    private bool CanAdvancePhase { get; set; }
    private bool IsBracketComplete { get; set; }

    private bool CanGenerateKnockout =>
        IsFixtureGenerated && IsGroupStageComplete && !IsKnockoutGenerated;

    // Las pistas hablan según el rol: a quien no tiene el botón no se le pide que lo toque.
    private WizardStep CurrentStep
    {
        get
        {
            if (!HasBaseData)
            {
                return new WizardStep(1, "Cargar datos base", IsAdmin
                    ? "Necesitás 48 equipos y al menos 4 estadios antes de generar el fixture."
                    : "Un administrador tiene que cargar los 48 equipos y al menos 4 estadios.", "step-1");
            }
            if (!IsFixtureGenerated)
            {
                return new WizardStep(2, "Generar fixture", CanManageFixture
                    ? "Hacé clic en Generar fixture para crear los 12 grupos y los 72 partidos."
                    : "Falta que un administrador o editor genere el fixture.", "step-2");
            }
            if (!IsKnockoutGenerated)
            {
                if (IsGroupStageComplete)
                {
                    return new WizardStep(3, "Sortear cruces de fase 2", CanManageFixture
                        ? "La fase de grupos terminó. Sorteá los cruces de 16avos de final."
                        : "La fase de grupos terminó. Falta sortear los cruces de 16avos de final.", "step-3");
                }
                return new WizardStep(3, "Jugar fase de grupos", CanManageFixture
                    ? $"Faltan {pendingGroupMatches} partidos. Simulalos desde el Simulador o cargalos en Partidos."
                    : $"Faltan {pendingGroupMatches} partidos de la fase de grupos.", "step-3");
            }
            if (!IsBracketComplete)
            {
                return new WizardStep(4, "Simular bracket", CanManageFixture
                    ? "Avanzá las rondas eliminatorias hasta el final."
                    : "Se están jugando las rondas eliminatorias.", "step-4");
            }
            return new WizardStep(4, "Torneo completo", "El bracket está simulado de punta a punta.", "step-done");
        }
    }

    protected override void OnInitialized()
    {
        ReloadState();
    }

    private void ReloadState()
    {
        try
        {
            FixtureSnapshotDto snapshot = FixtureViewService.GetSnapshot();
            settings = snapshot.Settings;
            selectedEngine ??= settings?.SelectedSimulationEngine;
            teamCount = snapshot.TeamCount;
            stadiumCount = StadiumService.GetAllStadiums().Count;
            // Una vez por recarga, no en cada render: cada tabla consulta la base. Grupos y tablas
            // se asignan juntos para que el markup nunca busque un grupo que el diccionario no tiene.
            List<Group> loadedGroups = snapshot.Groups.ToList();
            standingsByGroup = StandingsByGroup(loadedGroups);
            groups = loadedGroups;
            groupMatches = snapshot.GroupMatches.ToList();
            eliminationMatches = snapshot.EliminationMatches.ToList();
            pendingGroupMatches = StandingsService.PendingGroupStageMatchCount();
            IsFixtureGenerated = FixtureOrchestrator.IsFixtureGenerated();
            IsKnockoutGenerated = KnockoutGenerator.IsBracketGenerated();
            IsGroupStageComplete = StandingsService.IsGroupStageComplete();
            CanAdvancePhase = KnockoutGenerator.CanAdvanceToNextRound();
            IsBracketComplete = KnockoutGenerator.IsBracketComplete();
            exportFromDate ??= snapshot.EarliestMatchDate?.Date ?? settings?.StartDate.Date ?? DateTime.UtcNow.Date;
            exportToDate ??= snapshot.LatestMatchDate?.Date ?? exportFromDate;
        }
        catch (Exception ex)
        {
            errors.Add($"Error al cargar el estado: {ex.Message}");
        }
    }

    // Una sola llamada trae las tablas de todos los grupos; se reparten por los equipos de cada grupo.
    // Todo grupo queda con su entrada (vacía si falló) porque el markup la indexa por nombre.
    private Dictionary<string, List<GroupStandingDto>> StandingsByGroup(List<Group> loadedGroups)
    {
        List<GroupStandingDto> allStandings;
        try
        {
            allStandings = StandingsService.GetStandingsForAllGroups();
        }
        catch (GroupServicesException ex)
        {
            Logger.LogError(ex, "Unexpected error while loading the group standings.");
            if (!errors.Contains(StandingsLoadErrorMessage))
            {
                errors.Add(StandingsLoadErrorMessage);
            }
            allStandings = new List<GroupStandingDto>();
        }

        return loadedGroups.ToDictionary(
            group => group.Name,
            group => allStandings.Where(standing => group.Teams.Any(team => team.Id == standing.Team.Id)).ToList());
    }

    private List<MatchGroup> MatchesForSelectedGroup()
    {
        if (selectedGroupName == null) return new List<MatchGroup>();
        return groupMatches
            .Where(match => match.Group != null && match.Group.Name == selectedGroupName)
            .ToList();
    }

    private void HandleSelectGroup(string groupName)
    {
        selectedGroupName = groupName;
    }

    private void HandleClearSelection()
    {
        selectedGroupName = null;
    }

    private void HandleResultSaved(string message)
    {
        errors.Clear();
        successMessage = message;
        ReloadState();
    }

    private async Task HandleGenerateFixtureAsync()
    {
        await RunAdminActionAsync(
            () => FixtureOrchestrator.GenerateGroupStage(fixtureSeedInput, selectedEngine, Session.CurrentUser?.email),
            "Fixture generado correctamente.");
    }

    private void StartRegenerateConfirmation()
    {
        confirmingRegenerate = true;
    }

    private void CancelRegenerateConfirmation()
    {
        confirmingRegenerate = false;
    }

    private async Task HandleRegenerateFixtureAsync()
    {
        confirmingRegenerate = false;
        await RunAdminActionAsync(
            () => FixtureOrchestrator.RegenerateGroupStage(fixtureSeedInput, selectedEngineName: null, Session.CurrentUser?.email),
            "Fixture regenerado correctamente.");
    }

    private async Task HandleSimulateGroupStageAsync()
    {
        int seed = simulationSeedInput ?? settings?.SimulationSeed ?? 0;
        await RunAdminActionAsync(
            () => SimulationService.SimulateGroupStage(seed, Session.CurrentUser?.email),
            "Fase de grupos simulada correctamente.");
    }

    private void StartDeleteConfirmation()
    {
        confirmingDelete = true;
    }

    private void CancelDeleteConfirmation()
    {
        confirmingDelete = false;
    }

    private async Task HandleDeleteFixtureAsync()
    {
        confirmingDelete = false;
        await RunAdminActionAsync(
            () => FixtureOrchestrator.DeleteGroupStage(Session.CurrentUser?.email),
            "Fixture borrado. Podés generar uno nuevo.");
    }

    private async Task HandleGenerateKnockoutAsync()
    {
        await RunAdminActionAsync(
            () => KnockoutGenerator.GenerateBracket(crossingsSeedInput, Session.CurrentUser?.email),
            "Cruces de fase 2 generados.");
    }

    private async Task HandleSimulateNextRoundAsync()
    {
        await RunAdminActionAsync(
            () => KnockoutGenerator.SimulateNextRound(Session.CurrentUser?.email),
            "Ronda simulada.");
    }

    private async Task HandleSimulateUntilFinalAsync()
    {
        await RunAdminActionAsync(
            () => KnockoutGenerator.SimulateUntilFinal(Session.CurrentUser?.email),
            "Bracket simulado hasta el final.");
    }

    private async Task HandleAdvancePhaseAsync()
    {
        await RunAdminActionAsync(
            () => KnockoutGenerator.AdvanceToNextRound(Session.CurrentUser?.email),
            "Fase avanzada. Cargá los resultados de la nueva ronda en Partidos.");
    }

    private async Task HandleFillTeamsAsync()
    {
        int completionSeed = settings?.CompletionSeed ?? 0;
        await RunAdminActionAsync(
            () => TeamServices.FillToFortyEight(completionSeed, Session.CurrentUser?.email),
            "Equipos demo cargados.");
    }

    private async Task HandleExportFixtureAsync()
    {
        errors.Clear();
        isExporting = true;
        try
        {
            ExportFileDto file = ExportService.ExportFixture(
                new DateRange(exportFromDate ?? DateTime.UtcNow.Date, exportToDate ?? DateTime.UtcNow.Date),
                exportFormat,
                Session.CurrentUser!);

            await JS.InvokeVoidAsync(
                "downloadExportFile",
                file.FileName,
                file.ContentType,
                Convert.ToBase64String(file.Content));
        }
        catch (ExportServiceException ex)
        {
            errors.Add(ex.Message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while exporting the fixture.");
            errors.Add(UnexpectedErrorMessage);
        }
        finally
        {
            isExporting = false;
        }
    }

    private async Task HandleSeedStadiumsAsync()
    {
        await RunAdminActionAsync(
            () => StadiumService.SeedDefaultStadiums(Session.CurrentUser?.email),
            "Estadios demo cargados.");
    }

    private async Task RunAdminActionAsync(Action action, string successText)
    {
        errors.Clear();
        successMessage = null;
        isBusy = true;
        try
        {
            await Task.Run(action);
            successMessage = successText;
        }
        catch (FixtureOrchestratorException ex) { errors.Add(ex.Message); }
        catch (MatchServicesException ex) { errors.Add(ex.Message); }
        catch (GroupServicesException ex) { errors.Add(ex.Message); }
        catch (StadiumServicesException ex) { errors.Add(ex.Message); }
        catch (TeamServicesException ex) { errors.Add(ex.Message); }
        catch (SettingsException ex) { errors.Add(ex.Message); }
        catch (ArgumentException ex) { errors.Add(ex.Message); }
        catch (InvalidOperationException ex) { errors.Add(ex.Message); }
        catch (KnockoutGeneratorException ex) { errors.Add(ex.Message); }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while running a fixture action.");
            errors.Add(UnexpectedErrorMessage);
        }
        finally
        {
            // Tambien tras un error: una simulacion que falla a mitad ya pudo guardar rondas.
            ReloadState();
            isBusy = false;
        }
    }

    private string RegenerateFixtureTooltip()
    {
        if (IsKnockoutGenerated) return "No se puede regenerar: ya hay cruces de fase 2.";
        return "Borra los partidos de grupos y vuelve a generar el fixture.";
    }

    private string AdvancePhaseTooltip()
    {
        if (IsBracketComplete) return "El cuadro ya llegó a la final.";
        if (!CanAdvancePhase) return "Cargá los resultados de todos los partidos de la ronda actual antes de avanzar.";
        return "Crea la siguiente ronda con los ganadores y la deja pendiente para cargar resultados a mano.";
    }

    private string GenerateKnockoutTooltip()
    {
        if (!IsGroupStageComplete) return $"Faltan {pendingGroupMatches} partidos de fase de grupos por simular.";
        if (IsKnockoutGenerated) return "Los cruces ya están generados.";
        return "Sortea los 16 cruces de 16avos de final.";
    }


    private sealed record WizardStep(int Number, string Title, string Hint, string CssClass);
}
