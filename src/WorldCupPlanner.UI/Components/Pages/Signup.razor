@page "/signup"
@using WorldCupPlanner.Domain
@using WorldCupPlanner.Services
@using WorldCupPlanner.Services.DTOs
@using WorldCupPlanner.Services.Interfaces
@inject IUserService UserServices
@inject NavigationManager Nav

<PageTitle>Crear cuenta · Golazo</PageTitle>

<section class="auth-wrap">
    <div class="m26-card auth-card">
        <div class="m26-card-header auth-head">
            <img class="auth-logo" src="img/golazo-mark.svg" alt="" width="56" height="56" />
            <h1 class="auth-title mb-0">Crear cuenta</h1>
        </div>
        <div class="auth-body">
            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="alert alert-error" role="alert">
                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                    @error
                </div>
            }

            <form @onsubmit="Register">
                <div class="mb-3">
                    <label class="form-label" for="signupName">Nombre</label>
                    <input id="signupName" class="form-control" autocomplete="given-name" placeholder="Nombre"
                           @bind="name" @bind:event="oninput" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="signupLastname">Apellido</label>
                    <input id="signupLastname" class="form-control" autocomplete="family-name" placeholder="Apellido"
                           @bind="lastname" @bind:event="oninput" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="signupEmail">Email</label>
                    <input id="signupEmail" class="form-control" type="email" autocomplete="email" placeholder="tu@email.com"
                           @bind="email" @bind:event="oninput" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="signupPassword">Contraseña</label>
                    <input id="signupPassword" class="form-control" type="password" autocomplete="new-password" placeholder="••••••••"
                           aria-describedby="signupPasswordHelp" @bind="password" @bind:event="oninput" />
                    <div id="signupPasswordHelp" class="form-text">Mínimo 8 caracteres, con mayúscula, minúscula, número y símbolo.</div>
                </div>
                <div class="mb-4">
                    <label class="form-label" for="signupBirth">Fecha de nacimiento</label>
                    <input id="signupBirth" class="form-control" type="date" autocomplete="bday" @bind="dateOfBirth" />
                </div>

                <button class="btn btn-primary w-100" type="submit">Crear cuenta</button>
            </form>

            <p class="auth-switch">¿Ya tenés cuenta? <a href="login">Ingresá</a></p>
        </div>
    </div>
</section>

@code {
    private string name = "";
    private string lastname = "";
    private string email = "";
    private string password = "";
    private DateTime dateOfBirth = DateTime.Today;
    private string? error;

    private void Register()
    {
        error = null;

        try
        {
            UserServices.RegisterUser(new CreateUserRequestDto
            {
                Id = 0,
                Name = name.Trim(),
                Lastname = lastname.Trim(),
                Email = email.Trim(),
                Password = password,
                DateOfBirth = dateOfBirth,
                // El registro publico crea cuentas Periodista; el servicio lo fuerza de todos modos.
                InitialRole = UserRoles.Periodista
            });

            Nav.NavigateTo("/login?registrado=true");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
    
}