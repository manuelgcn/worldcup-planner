@page "/import"
@using WorldCupPlanner.Domain
@using WorldCupPlanner.Services
@using WorldCupPlanner.Services.DTOs
@using WorldCupPlanner.Services.Interfaces
@inject IImportService ImportService
@inject SessionState Session

<PageTitle>Importar equipos · Golazo</PageTitle>

@if (!Session.IsLoggedIn)
{
    <h1 class="m26-page-title">Importar equipos</h1>
    <LoginRequired />
}
else if (!CanImport)
{
    <div class="alert alert-error" role="alert">
        <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
        No tenés permisos para importar equipos.
    </div>
}
else
{
    <h1 class="m26-page-title">Importar equipos (CSV)</h1>

    <article class="m26-card pane">
        <label class="import-drop" for="importFile">
            <i class="bi bi-filetype-csv import-drop-icon" aria-hidden="true"></i>
            <span class="import-drop-title">Arrastrá tu archivo CSV acá</span>
            <span class="import-drop-hint">o hacé clic para elegirlo</span>
            <InputFile id="importFile" OnChange="OnFileSelected" accept=".csv" class="import-drop-input" />
        </label>

        <p class="import-help">
            El archivo necesita los encabezados <code>Nombre, Confederacion, RankingFIFA</code>.
            La importación se cancela ante el primer error: nombre vacío o de más de 60 caracteres,
            confederación desconocida, ranking fuera de 300–2500 o equipo duplicado.
        </p>

        @if (result is not null)
        {
            <div class="alert alert-success mt-3 mb-0" role="status">
                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                <strong>@result.ImportedCount @(result.ImportedCount == 1 ? "equipo importado" : "equipos importados").</strong>

                @if (!string.IsNullOrWhiteSpace(result.WarningMessage))
                {
                    <div class="mt-2">
                        <strong>Advertencia:</strong> @result.WarningMessage
                    </div>
                }

                @if (result.ImportedTeams.Any())
                {
                    <ul class="mb-0 mt-2">
                        @foreach (Team team in result.ImportedTeams)
                        {
                            <li>@team.Name (@team.Confederation, ranking @team.FifaRanking)</li>
                        }
                    </ul>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-error mt-3 mb-0" role="alert">
                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                @error
            </div>
        }
    </article>
}

@code {
    private ImportResult? result;
    private string? error;

    private bool CanImport =>
        Session.CurrentUser?.HasRole(UserRoles.Admin) == true ||
        Session.CurrentUser?.HasRole(UserRoles.Editor) == true;

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        error = null;
        result = null;

        try
        {
            await using Stream upload = e.File.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using MemoryStream buffer = new MemoryStream();
            await upload.CopyToAsync(buffer);
            buffer.Position = 0;

            result = ImportService.ImportTeams(buffer, Session.CurrentUser?.email);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}