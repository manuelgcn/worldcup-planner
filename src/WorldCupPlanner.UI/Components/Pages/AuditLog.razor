@page "/audit-log"
@using WorldCupPlanner.Domain
@using WorldCupPlanner.Services
@using WorldCupPlanner.Services.DTOs
@using WorldCupPlanner.Services.Exceptions
@using WorldCupPlanner.Services.Interfaces
@using Microsoft.JSInterop
@inject IAuditLogService AuditLogService
@inject IExportService ExportService
@inject SessionState Session
@inject IJSRuntime JS

<PageTitle>Log de auditoría · Golazo</PageTitle>

@if (!Session.IsLoggedIn)
{
    <h1 class="m26-page-title">Log de auditoría</h1>
    <LoginRequired />
}
else if (!CanExport)
{
    <div class="alert alert-error" role="alert">
        <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
        No tenés permisos para ver el log.
    </div>
}
else
{
    <h1 class="m26-page-title">Log de auditoría</h1>

    <div class="m26-card audit-filters">
        <input class="form-control filter-action"
               placeholder="Filtrar por acción (ej: CREATE_USER)"
               aria-label="Filtrar por acción"
               @bind="actionFilter" @bind:event="oninput" @bind:after="LoadLogs" />
        <input class="form-control filter-action"
               placeholder="Filtrar por usuario (email)"
               aria-label="Filtrar por usuario"
               @bind="emailFilter" @bind:event="oninput" @bind:after="LoadLogs" />
        <input class="form-control filter-date" type="date" aria-label="Desde" @bind="fromDate" @bind:after="LoadLogs" />
        <input class="form-control filter-date" type="date" aria-label="Hasta" @bind="toDate" @bind:after="LoadLogs" />
        <button class="btn btn-outline-secondary" @onclick="ClearFilters">
            <i class="bi bi-x-circle" aria-hidden="true"></i> Limpiar
        </button>
        <select class="form-select filter-action" aria-label="Formato de exportación" @bind="exportFormat">
            <option value="@ExportFormat.Csv">CSV</option>
            <option value="@ExportFormat.Xlsx">XLSX</option>
        </select>
        <button class="btn btn-outline-primary" disabled="@isExporting" @onclick="ExportAsync">
            <i class="bi bi-download" aria-hidden="true"></i> Exportar log
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(exportError))
    {
        <div class="alert alert-error" role="alert">@exportError</div>
    }

    <article class="m26-card pane">
        @if (!logs.Any())
        {
            <div class="m26-empty">
                <i class="bi bi-journal-x" aria-hidden="true"></i>
                <p class="mb-0">No hay registros que coincidan.</p>
            </div>
        }
        else
        {
            <div class="table-responsive" tabindex="0" role="region" aria-label="Registros de auditoría">
                <table class="table m26-scoreboard audit-table mb-0">
                    <thead>
                        <tr>
                            <th>Timestamp</th>
                            <th>Acción</th>
                            <th>Usuario</th>
                            <th>Torneo</th>
                            <th>Entidad</th>
                            <th>ID</th>
                            <th>Detalle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (AuditLogDto log in logs)
                        {
                            <tr>
                                <td class="text-nowrap" title="@log.Timestamp.ToString("o")">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td><span class="audit-action">@log.Action</span></td>
                                <td>@(log.PerformedByEmail ?? "—")</td>
                                <td>@(log.TournamentSettingsId?.ToString() ?? "—")</td>
                                <td>@(log.EntityType ?? "—")</td>
                                <td>@(log.EntityId?.ToString() ?? "—")</td>
                                <td class="audit-details">@log.Details</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </article>
}

@code {
    private string actionFilter = "";
    private string emailFilter = "";
    private DateTime? fromDate;
    private DateTime? toDate;

    private List<AuditLogDto> logs = new();

    private ExportFormat exportFormat = ExportFormat.Csv;
    private bool isExporting;
    private string? exportError;

    private bool CanExport =>
        Session.IsLoggedIn &&
        (Session.CurrentUser!.HasRole(UserRoles.Admin) || Session.CurrentUser.HasRole(UserRoles.Periodista));

    protected override void OnInitialized()
    {
        if (CanExport)
        {
            LoadLogs();
        }
    }

    // El filtrado corre en el servicio/repositorio (SQL); la vista solo ordena para presentar.
    private void LoadLogs()
    {
        logs = AuditLogService.GetFiltered(BuildFilter())
            .OrderByDescending(l => l.Timestamp)
            .ToList();
    }

    private AuditLogFilterDto BuildFilter()
    {
        return new AuditLogFilterDto
        {
            From = fromDate?.Date,
            To = toDate?.Date.AddDays(1).AddTicks(-1),
            Action = string.IsNullOrWhiteSpace(actionFilter) ? null : actionFilter,
            PerformedByEmail = string.IsNullOrWhiteSpace(emailFilter) ? null : emailFilter
        };
    }

    private void ClearFilters()
    {
        actionFilter = "";
        emailFilter = "";
        fromDate = null;
        toDate = null;
        exportError = null;
        LoadLogs();
    }

    private async Task ExportAsync()
    {
        exportError = null;
        isExporting = true;
        try
        {
            DateTime defaultDate = DateTime.UtcNow.Date;
            DateTime exportFrom = fromDate?.Date ?? logs.Select(log => log.Timestamp.Date).DefaultIfEmpty(defaultDate).Min();
            DateTime exportTo = toDate?.Date ?? logs.Select(log => log.Timestamp.Date).DefaultIfEmpty(defaultDate).Max();
            ExportFileDto file = ExportService.ExportAuditLog(
                new DateRange(exportFrom, exportTo),
                exportFormat,
                Session.CurrentUser!,
                BuildFilter());

            await JS.InvokeVoidAsync(
                "downloadExportFile",
                file.FileName,
                file.ContentType,
                Convert.ToBase64String(file.Content));
        }
        catch (ExportServiceException ex)
        {
            exportError = ex.Message;
        }
        finally
        {
            isExporting = false;
        }
    }
}
