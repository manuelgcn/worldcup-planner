@page "/notifications"
@using WorldCupPlanner.Domain
@using WorldCupPlanner.Services.Interfaces
@inject SessionState Session
@inject INotificationService NotificationService
@inject NavigationManager Nav

<PageTitle>Notificaciones · Golazo</PageTitle>

<h1 class="m26-page-title">Notificaciones</h1>

@if (!Session.IsLoggedIn)
{
    <LoginRequired />
}
else if (!Session.IsJournalist)
{
    <div class="alert alert-info" role="status">
        <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
        Las notificaciones de resultados son exclusivas para periodistas.
    </div>
}
else
{
    <section class="m26-card pane">
        @if (unreadNotifications.Any())
        {
            <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
                <p class="notification-count mb-0">
                    @(unreadNotifications.Count == 1 ? "1 notificación sin leer" : $"{unreadNotifications.Count} notificaciones sin leer")
                </p>

                <button class="btn btn-sm btn-outline-primary" @onclick="MarkAllNotificationsAsRead">
                    <i class="bi bi-check2-all" aria-hidden="true"></i>
                    Marcar todas como leídas
                </button>
            </div>
        }

        @if (!unreadNotifications.Any())
        {
            <div class="m26-empty">
                <i class="bi bi-bell" aria-hidden="true"></i>
                <p class="mb-0">No tenés notificaciones pendientes.</p>
            </div>
        }
        else
        {
            <ul class="notification-list">
                @foreach (Notification notification in unreadNotifications)
                {
                    <li class="notification-item">
                        <span class="notification-icon" aria-hidden="true"><i class="bi bi-bell-fill"></i></span>
                        <div class="notification-body">
                            <p class="notification-message">@notification.Message</p>
                            <time class="notification-time">
                                @notification.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </time>
                        </div>

                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="() => MarkNotificationAsRead(notification.Id)">
                            Marcar como leída
                        </button>
                    </li>
                }
            </ul>
        }
    </section>
}

@code {
    private IReadOnlyCollection<Notification> unreadNotifications = Array.Empty<Notification>();

    protected override void OnInitialized()
    {
        if (!Session.IsLoggedIn || !Session.IsJournalist)
        {
            Nav.NavigateTo("/");
            return;
        }

        LoadUnreadNotifications();
    }

    private void LoadUnreadNotifications()
    {
        unreadNotifications = NotificationService.GetUnreadForUser(Session.CurrentUser!.idUser);
    }

    private void MarkNotificationAsRead(int notificationId)
    {
        NotificationService.MarkAsRead(notificationId, Session.CurrentUser!.idUser);
        LoadUnreadNotifications();
    }

    private void MarkAllNotificationsAsRead()
    {
        NotificationService.MarkAllAsRead(Session.CurrentUser!.idUser);
        LoadUnreadNotifications();
    }
}
