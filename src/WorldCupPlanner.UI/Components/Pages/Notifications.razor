@page "/notifications"
@using WorldCupPlanner.Domain
@using WorldCupPlanner.Services.Interfaces
@inject SessionState Session
@inject INotificationService NotificationService
@inject NavigationManager Nav

<PageTitle>Notificaciones</PageTitle>

@if (Session.IsLoggedIn && Session.IsJournalist)
{
    <section class="m26-card pane">
        <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
            <h1 class="pane-title mb-0">Notificaciones</h1>

            @if (unreadNotifications.Any())
            {
                <button class="btn btn-sm btn-outline-primary" @onclick="MarkAllNotificationsAsRead">
                    <i class="bi bi-check2-all" aria-hidden="true"></i>
                    Marcar todas como leidas
                </button>
            }
        </div>

        @if (!unreadNotifications.Any())
        {
            <div class="m26-empty mt-3">
                <i class="bi bi-bell" aria-hidden="true"></i>
                <p class="mb-0">No tenes notificaciones pendientes.</p>
            </div>
        }
        else
        {
            <ul class="list-group list-group-flush mt-3">
                @foreach (Notification notification in unreadNotifications)
                {
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <div>@notification.Message</div>
                                <small class="text-muted">
                                    @notification.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>

                            <button class="btn btn-sm btn-outline-primary"
                                    @onclick="() => MarkNotificationAsRead(notification.Id)">
                                Marcar como leida
                            </button>
                        </div>
                    </li>
                }
            </ul>
        }
    </section>
}

@code {
    private IReadOnlyCollection<Notification> unreadNotifications = Array.Empty<Notification>();

    protected override void OnInitialized()
    {
        if (!Session.IsLoggedIn || !Session.IsJournalist)
        {
            Nav.NavigateTo("/");
            return;
        }

        LoadUnreadNotifications();
    }

    private void LoadUnreadNotifications()
    {
        unreadNotifications = NotificationService.GetUnreadForUser(Session.CurrentUser!.idUser);
    }

    private void MarkNotificationAsRead(int notificationId)
    {
        NotificationService.MarkAsRead(notificationId, Session.CurrentUser!.idUser);
        LoadUnreadNotifications();
    }

    private void MarkAllNotificationsAsRead()
    {
        NotificationService.MarkAllAsRead(Session.CurrentUser!.idUser);
        LoadUnreadNotifications();
    }
}
