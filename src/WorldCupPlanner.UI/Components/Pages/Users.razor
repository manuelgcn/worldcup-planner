@page "/users"
@using WorldCupPlanner.Domain
@using WorldCupPlanner.Services
@using WorldCupPlanner.Services.DTOs
@using WorldCupPlanner.Services.Interfaces
@inject IUserService UserServices
@inject SessionState Session

<PageTitle>Usuarios · Golazo</PageTitle>

<h1 class="m26-page-title">Usuarios</h1>

@if (!Session.IsLoggedIn)
{
    <LoginRequired />
}
else if (!IsAdmin)
{
    <div class="alert alert-error" role="alert">
        <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
        No tenés permisos para administrar usuarios.
    </div>
}
else
{
    <FeedbackAlerts Errors="errors" SuccessMessage="@successMessage" />

    <section class="admin-stack">
        <article class="m26-card pane">
            <h2 class="pane-title">@(editingUserId is null ? "Crear usuario" : $"Editar usuario #{editingUserId}")</h2>

            <div class="form-grid">
                <div class="mb-3">
                    <label class="form-label" for="userName">Nombre</label>
                    <input id="userName" class="form-control" @bind="name" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="userLastname">Apellido</label>
                    <input id="userLastname" class="form-control" @bind="lastname" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="userEmail">Email</label>
                    <input id="userEmail" class="form-control" @bind="email" />
                </div>

                @if (editingUserId is null)
                {
                    <div class="mb-3">
                        <label class="form-label" for="userPassword">Contraseña</label>
                        <input id="userPassword" class="form-control" type="password" @bind="password" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="userBirth">Fecha de nacimiento</label>
                        <input id="userBirth" class="form-control" type="date" @bind="dateOfBirth" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="userRole">Rol inicial</label>
                        <select id="userRole" class="form-select" @bind="initialRole">
                            @foreach (UserRoles role in Enum.GetValues<UserRoles>())
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                    </div>
                }
            </div>

            <div class="d-flex gap-2">
                @if (editingUserId is null)
                {
                    <button class="btn btn-primary" @onclick="Create">
                        <i class="bi bi-plus-circle-fill" aria-hidden="true"></i>
                        Crear
                    </button>
                }
                else
                {
                    <button class="btn btn-primary" @onclick="SaveEdit">
                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                        Guardar
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="CancelEdit">Cancelar</button>
                }
            </div>
        </article>

        <article class="m26-card pane">
            <h2 class="pane-title">Usuarios existentes</h2>

            @if (!usuarios.Any())
            {
                <div class="m26-empty">
                    <i class="bi bi-people" aria-hidden="true"></i>
                    <p class="mb-0">No hay usuarios.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover m26-scoreboard mb-0">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Email</th>
                                <th>Roles</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (User u in usuarios)
                            {
                                <tr>
                                    <td>@u.idUser</td>
                                    <td>
                                        @u.name @u.lastname
                                        @* Explica en pantalla por qué sus botones están deshabilitados. *@
                                        @if (u.idUser == 1)
                                        {
                                            <span class="d-block small text-muted">Administrador del sistema</span>
                                        }
                                        else if (u.idUser == Session.CurrentUser!.idUser)
                                        {
                                            <span class="d-block small text-muted">Tu usuario</span>
                                        }
                                    </td>
                                    <td>@u.email</td>
                                    <td>
                                        @foreach (var r in u.Roles)
                                        {
                                            <span class="m26-conf-badge role-@r.Role me-1">@r.Role</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex flex-nowrap align-items-center gap-1">
                                            @* Mientras se confirma, la fila muestra solo la pregunta: al lado de los roles no entraba. *@
                                            @if (confirmingDeleteId == u.idUser)
                                            {
                                                <span class="me-2">¿Eliminar <strong>@u.name @u.lastname</strong>?</span>
                                                <button class="btn btn-danger btn-sm me-1" @onclick="() => Remove(u.idUser)">
                                                    Sí, eliminar
                                                </button>
                                                <button class="btn btn-outline-secondary btn-sm" @onclick="CancelDelete">
                                                    Cancelar
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-primary btn-sm" @onclick="() => StartEdit(u)">
                                                    <i class="bi bi-pencil" aria-hidden="true"></i> Editar
                                                </button>

                                                <button class="btn btn-sm @RoleButtonClass(u, UserRoles.Admin)"
                                                        aria-pressed="@(u.HasRole(UserRoles.Admin) ? "true" : "false")"
                                                        title="@(u.HasRole(UserRoles.Admin) ? "Quitar rol Admin" : "Asignar rol Admin")"
                                                        disabled="@(u.idUser == 1 || u.idUser == Session.CurrentUser!.idUser)"
                                                        @onclick="() => ToggleRole(u, UserRoles.Admin)">
                                                    <i class="bi bi-shield-fill" aria-hidden="true"></i>
                                                    Admin
                                                </button>

                                                <button class="btn btn-sm @RoleButtonClass(u, UserRoles.Editor)"
                                                        aria-pressed="@(u.HasRole(UserRoles.Editor) ? "true" : "false")"
                                                        title="@(u.HasRole(UserRoles.Editor) ? "Quitar rol Editor" : "Asignar rol Editor")"
                                                        disabled="@(u.idUser == 1)"
                                                        @onclick="() => ToggleRole(u, UserRoles.Editor)">
                                                    <i class="bi bi-person-check-fill" aria-hidden="true"></i>
                                                    Editor
                                                </button>

                                                <button class="btn btn-sm @RoleButtonClass(u, UserRoles.Periodista)"
                                                        aria-pressed="@(u.HasRole(UserRoles.Periodista) ? "true" : "false")"
                                                        title="@(u.HasRole(UserRoles.Periodista) ? "Quitar rol Periodista" : "Asignar rol Periodista")"
                                                        disabled="@(u.idUser == 1)"
                                                        @onclick="() => ToggleRole(u, UserRoles.Periodista)">
                                                    <i class="bi bi-newspaper" aria-hidden="true"></i>
                                                    Periodista
                                                </button>

                                                <button class="btn btn-outline-danger btn-sm"
                                                        disabled="@(u.idUser == 1 || u.idUser == Session.CurrentUser!.idUser)"
                                                        @onclick="() => StartDelete(u.idUser)">
                                                    <i class="bi bi-trash" aria-hidden="true"></i> Eliminar
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </article>
    </section>
}

@code {
    private const string MissingDateOfBirthMessage = "La fecha de nacimiento es obligatoria.";

    // Los botones de rol son interruptores: el rol asignado se ve "encendido".
    private static string RoleButtonClass(User user, UserRoles role) =>
        user.HasRole(role) ? "btn-secondary role-on" : "btn-outline-secondary";

    private string name = "";
    private string lastname = "";
    private string email = "";
    private string password = "";
    // Vacía al inicio: con "hoy" por defecto, quien no la tocaba siempre chocaba con la mayoría de edad.
    private DateTime? dateOfBirth;
    private UserRoles initialRole = UserRoles.Editor;

    private int? editingUserId;

    private List<string> errors = new();
    private string? successMessage;

    private List<User> usuarios = new();

    private bool IsAdmin =>
        Session.IsLoggedIn && Session.CurrentUser!.HasRole(UserRoles.Admin);

    protected override void OnInitialized()
    {
        LoadUsers();
    }

    private void LoadUsers()
    {
        usuarios = UserServices.GetAllUsers().ToList();
    }

    private async Task Create()
    {
        errors.Clear();
        successMessage = null;

        if (!await IsStillAdminAsync())
            return;

        if (dateOfBirth is null)
        {
            errors.Add(MissingDateOfBirthMessage);
            return;
        }

        try
        {
            UserServices.CreateUser(new CreateUserRequestDto
            {
                Id = 0,
                Name = name,
                Lastname = lastname,
                Email = email,
                Password = password,
                DateOfBirth = dateOfBirth.Value,
                InitialRole = initialRole
            }, Session.CurrentUser?.email);

            successMessage = "Usuario creado correctamente";
            ClearForm();
            LoadUsers();
        }
        catch (Exception ex)
        {
            errors.Add(ex.Message);
        }
    }

    // La página pudo quedar abierta después de que otro admin le quitara el rol o diera de baja a este usuario.
    private async Task<bool> IsStillAdminAsync()
    {
        await Session.RevalidateAsync();
        return IsAdmin;
    }

    private void StartEdit(User u)
    {
        errors.Clear();
        successMessage = null;

        editingUserId = u.idUser;
        name = u.name;
        lastname = u.lastname ?? "";
        email = u.email;
    }

    private void CancelEdit()
    {
        editingUserId = null;
        ClearForm();
    }

    private async Task SaveEdit()
    {
        errors.Clear();
        successMessage = null;

        if (!await IsStillAdminAsync())
            return;

        try
        {
            int id = editingUserId!.Value;
            UserServices.UpdateUser(id, name, lastname, email, Session.CurrentUser?.email);

            // La sesión guarda una copia del usuario: si se editó a sí mismo, se recarga como en EditUser.
            if (id == Session.CurrentUser!.idUser)
                await Session.LoginAsync(UserServices.GetUserById(id));

            successMessage = "Usuario actualizado correctamente";
            editingUserId = null;
            ClearForm();
            LoadUsers();
        }
        catch (Exception ex)
        {
            errors.Add(ex.Message);
        }
    }

    private int? confirmingDeleteId;

    private void StartDelete(int id)
    {
        confirmingDeleteId = id;
    }

    private void CancelDelete()
    {
        confirmingDeleteId = null;
    }

    private async Task Remove(int id)
    {
        errors.Clear();
        successMessage = null;

        if (!await IsStillAdminAsync())
            return;
        confirmingDeleteId = null;

        try
        {
            UserServices.RemoveUser(id, Session.CurrentUser?.email);
            successMessage = "Usuario eliminado correctamente";
            LoadUsers();
        }
        catch (Exception ex)
        {
            errors.Add(ex.Message);
        }
    }

    private async Task ToggleRole(User user, UserRoles role)
    {
        errors.Clear();
        successMessage = null;

        if (!await IsStillAdminAsync())
            return;

        try
        {
            if (user.HasRole(role))
            {
                UserServices.RemoveRole(user.idUser, role, Session.CurrentUser?.email);
                successMessage = $"Rol {role} removido";
            }
            else
            {
                UserServices.AssignRole(user.idUser, role, Session.CurrentUser?.email);
                successMessage = $"Rol {role} asignado";
            }

            LoadUsers();

            // El menú y los permisos leen los roles de la copia en sesión: si cambió los propios, se recarga.
            if (user.idUser == Session.CurrentUser!.idUser)
                await Session.LoginAsync(UserServices.GetUserById(user.idUser));
        }
        catch (Exception ex)
        {
            errors.Add(ex.Message);
        }
    }

    private void ClearForm()
    {
        name = "";
        lastname = "";
        email = "";
        password = "";
        dateOfBirth = null;
        initialRole = UserRoles.Editor;
    }

}