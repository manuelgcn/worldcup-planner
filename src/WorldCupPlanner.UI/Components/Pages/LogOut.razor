@page "/logout"
@inject SessionState Session
@inject NavigationManager Nav

<PageTitle>Cerrar sesión · Golazo</PageTitle>

<section class="auth-wrap">
    <div class="m26-card auth-card">
        <div class="m26-card-header auth-head">
            <img class="auth-logo" src="img/golazo-mark.svg" alt="" width="56" height="56" />
            <h1 class="auth-title mb-0">Cerrar sesión</h1>
        </div>
        <div class="auth-body">
            <p class="mb-4">¿Querés cerrar tu sesión actual?</p>
            <button class="btn btn-primary w-100" @onclick="Logout">
                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                Cerrar sesión
            </button>
        </div>
    </div>
</section>

@code {
    private void Logout()
    {
        Session.Logout();
        Nav.NavigateTo("/");
    }
}