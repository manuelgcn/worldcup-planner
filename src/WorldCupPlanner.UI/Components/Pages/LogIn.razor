@page "/login"
@using WorldCupPlanner.Domain
@using WorldCupPlanner.Services
@using WorldCupPlanner.Services.Interfaces
@inject IUserService UserServices
@inject SessionState Session
@inject NavigationManager Nav

<PageTitle>Ingresar · Golazo</PageTitle>

<section class="auth-wrap">
    <div class="m26-card auth-card">
        <div class="m26-card-header auth-head">
            <img class="auth-logo" src="img/golazo-mark.svg" alt="" width="56" height="56" />
            <h1 class="auth-title mb-0">Ingresar</h1>
        </div>
        <div class="auth-body">

            @if (errors.Count > 0)
            {
                <div class="alert alert-error" role="alert">
                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                    Revisá los siguientes errores:
                    <ul>
                        @foreach (string error in errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }

            @if (Registered && errors.Count == 0)
            {
                <div class="alert alert-success" role="status">
                    <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                    ¡Cuenta creada! Ingresá con tu email y contraseña.
                </div>
            }

            <form @onsubmit="Login">
                <div class="mb-3">
                    <label class="form-label" for="loginEmail">Email</label>
                    <input id="loginEmail" class="form-control" type="email" autocomplete="username" placeholder="tu@email.com"
                           @bind="email" @bind:event="oninput" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="loginPassword">Contraseña</label>
                    <input id="loginPassword" class="form-control" type="password" autocomplete="current-password" placeholder="••••••••"
                           @bind="password" @bind:event="oninput" />
                </div>

                <button class="btn btn-primary w-100" type="submit">
                    Ingresar
                </button>
            </form>

            <p class="auth-switch">¿No tenés cuenta? <a href="signup">Creá una</a></p>

            <!-- ========================= -->
            <!-- TESTEO FUNCIONAL -->
            <!-- ========================= -->
            <hr />

            <div class="alert alert-info demo-credentials">
                <strong>Credenciales de prueba (solo para testeo funcional) NO MODIFICAR:</strong>
                <ul class="mb-0">
                    <li>
                        <strong>Administrador</strong><br />
                        Email: <code>admin@copa.com</code><br />
                        Password: <code>Admin@123</code>
                    </li>
                    <li class="mt-2">
                        <strong>Editor</strong><br />
                        Email: <code>editor@copa.com</code><br />
                        Password: <code>Editor@123</code>
                    </li>
                    <li class="mt-2">
                        <strong>Periodista</strong><br />
                        Email: <code>periodista@copa.com</code><br />
                        Password: <code>Periodista@123</code>
                    </li>
                </ul>
            </div>

        </div>
    </div>
</section>

@code {
    private string email = "";
    private string password = "";
    private readonly List<string> errors = new();

    // Signup redirige con ?registrado=true para confirmar que la cuenta se creó.
    [SupplyParameterFromQuery(Name = "registrado")]
    public bool Registered { get; set; }

    private void Login()
    {
        errors.Clear();

        if (!IsInputValid())
        {
            return;
        }

        try
        {
            User user = UserServices.Authenticate(email, password);

            Session.Login(user);
            Nav.NavigateTo(HomeRouteFor(user));
        }
        catch (Exception ex)
        {
            errors.Add(ex.Message);
        }
    }

    // El Periodista aterriza en sus notificaciones; el resto en el inicio.
    private static string HomeRouteFor(User user) =>
        user.HasRole(UserRoles.Periodista) && !user.HasRole(UserRoles.Admin) && !user.HasRole(UserRoles.Editor)
            ? "/notifications"
            : "/";

    private bool IsInputValid()
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            errors.Add("Ingresá tu email.");
        }

        if (string.IsNullOrWhiteSpace(password))
        {
            errors.Add("Ingresá tu contraseña.");
        }

        return errors.Count == 0;
    }
}