@page "/"
@using WorldCupPlanner.Domain
@using WorldCupPlanner.Services.Interfaces
@using WorldCupPlanner.Services.DTOs
@implements IDisposable
@inject SessionState Session
@inject INotificationService NotificationService
@inject ITournamentDashboardService DashboardService
@inject ILogger<Home> Logger

<PageTitle>Inicio · Golazo</PageTitle>

<section class="home-hero">
    <div class="hero-copy">
        <p class="hero-kicker">Mundial 2026 · 48 selecciones</p>
        <h1 class="hero-title">Golazo</h1>
        <p class="hero-lead">
            Del sorteo de grupos a la final: planificá, simulá y seguí cada partido del Mundial.
        </p>
        <p class="hero-status" role="status">
            <span class="hero-status-dot" aria-hidden="true"></span>
            @TournamentStatusText
        </p>
        <div class="hero-cta">
            @if (Session.IsLoggedIn)
            {
                <a class="btn btn-primary btn-lg" href="@PrimaryCta.Href">
                    <i class="bi @PrimaryCta.Icon" aria-hidden="true"></i>
                    @PrimaryCta.Label
                </a>
                <a class="btn btn-outline-primary btn-lg" href="/matches">
                    <i class="bi bi-calendar-event-fill" aria-hidden="true"></i>
                    Ver partidos
                </a>
            }
            else
            {
                <a class="btn btn-primary btn-lg" href="/login">
                    <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                    Ingresar
                </a>
                <a class="btn btn-outline-primary btn-lg" href="/signup">
                    <i class="bi bi-person-plus-fill" aria-hidden="true"></i>
                    Crear cuenta
                </a>
            }
        </div>
    </div>
    <div class="hero-art" aria-hidden="true">
        <i class="bi bi-trophy-fill"></i>
    </div>
</section>

@if (Session.IsLoggedIn && Session.IsJournalist && unreadCount > 0)
{
    <div class="alert alert-warning d-flex align-items-center gap-2 mt-4" role="alert">
        <i class="bi bi-bell-fill" aria-hidden="true"></i>
        <span>
            Tenés @unreadCount @(unreadCount == 1 ? "notificación sin leer" : "notificaciones sin leer").
        </span>
        <a class="alert-link" href="/notifications">Ver notificaciones</a>
    </div>
}

@if (!string.IsNullOrWhiteSpace(loadError))
{
    <div class="alert alert-error mt-4" role="alert">@loadError</div>
}

<section class="stats-grid">
    <article class="m26-card stat-card">
        <span class="stat-icon"><i class="bi bi-people-fill" aria-hidden="true"></i></span>
        <p class="stat-value">@teamCount / @RequiredTeamCount</p>
        <p class="stat-label">Equipos</p>
        <div class="stat-progress" aria-hidden="true"><span style="width: @Percent(teamCount, RequiredTeamCount)%"></span></div>
    </article>
    <article class="m26-card stat-card">
        <span class="stat-icon"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i></span>
        <p class="stat-value">@stadiumCount</p>
        <p class="stat-label">Estadios</p>
    </article>
    <article class="m26-card stat-card">
        <span class="stat-icon"><i class="bi bi-calendar-check-fill" aria-hidden="true"></i></span>
        <p class="stat-value">@playedMatches / @totalMatches</p>
        <p class="stat-label">Partidos jugados</p>
        <div class="stat-progress" aria-hidden="true"><span style="width: @Percent(playedMatches, totalMatches)%"></span></div>
    </article>
    <article class="m26-card stat-card stat-card-stage">
        <span class="stat-icon"><i class="bi bi-flag-fill" aria-hidden="true"></i></span>
        <p class="stat-value stat-value-text">@TournamentStageLabel</p>
        <p class="stat-label">Estado del torneo</p>
    </article>
</section>

<section class="how-it-works" aria-labelledby="howItWorksTitle">
    <h2 id="howItWorksTitle" class="how-title">Cómo funciona</h2>
    <ol class="how-steps">
        <li class="m26-card how-step">
            <span class="how-icon"><i class="bi bi-people-fill" aria-hidden="true"></i></span>
            <h3>Equipos y sedes</h3>
            <p>Cargá las 48 selecciones a mano o por CSV, con bandera y ranking, y los estadios del torneo.</p>
        </li>
        <li class="m26-card how-step">
            <span class="how-icon"><i class="bi bi-diagram-3-fill" aria-hidden="true"></i></span>
            <h3>Sorteo y fixture</h3>
            <p>12 grupos con cupos por confederación y un calendario reproducible gracias a la semilla.</p>
        </li>
        <li class="m26-card how-step">
            <span class="how-icon"><i class="bi bi-dice-5-fill" aria-hidden="true"></i></span>
            <h3>Simulación</h3>
            <p>Motores intercambiables juegan los partidos; también podés cargar cada resultado a mano.</p>
        </li>
        <li class="m26-card how-step">
            <span class="how-icon"><i class="bi bi-trophy-fill" aria-hidden="true"></i></span>
            <h3>Hasta la final</h3>
            <p>De 16avos a la final, con penales, ranking Elo actualizado y un campeón del mundo.</p>
        </li>
    </ol>
</section>

@code {
    private const string DashboardLoadErrorMessage =
        "No se pudo cargar el resumen del torneo. Intentá nuevamente más tarde.";
    private const int RequiredTeamCount = 48;

    private int unreadCount;
    private int teamCount;
    private int stadiumCount;
    private int playedMatches;
    private int totalMatches;
    private bool isFixtureGenerated;
    private bool isKnockoutGenerated;
    private string? championName;
    private string? loadError;

    private sealed record CtaLink(string Label, string Href, string Icon);

    private static int Percent(int value, int total) => total == 0 ? 0 : Math.Min(100, value * 100 / total);

    private bool CanManageTournament =>
        Session.CurrentUser?.HasRole(UserRoles.Admin) == true ||
        Session.CurrentUser?.HasRole(UserRoles.Editor) == true;

    private string TournamentStatusText
    {
        get
        {
            if (championName is not null)
            {
                return $"El torneo está completo: ¡{championName} es el campeón del mundo!";
            }
            if (isKnockoutGenerated)
            {
                return "El bracket eliminatorio está en curso.";
            }
            if (isFixtureGenerated)
            {
                return $"Fase de grupos en juego: {playedMatches} de {totalMatches} partidos disputados.";
            }
            return $"Preparando el torneo: {teamCount} de 48 equipos y {stadiumCount} estadios cargados.";
        }
    }

    private string TournamentStageLabel
    {
        get
        {
            if (championName is not null) return "¡Hay campeón!";
            if (isKnockoutGenerated) return "Bracket en curso";
            if (isFixtureGenerated) return "Fase de grupos";
            return "En preparación";
        }
    }

    private CtaLink PrimaryCta
    {
        get
        {
            if (!isFixtureGenerated && CanManageTournament)
            {
                return new CtaLink("Generar fixture", "/fixture", "bi-magic");
            }
            if (isFixtureGenerated && !isKnockoutGenerated && playedMatches < totalMatches && CanManageTournament)
            {
                return new CtaLink("Cargar resultados", "/fixture", "bi-pencil-square");
            }
            return new CtaLink("Ver fixture", "/fixture", "bi-diagram-3-fill");
        }
    }

    protected override void OnInitialized()
    {
        Session.OnChange += HandleSessionChanged;
        LoadState();
    }

    private void HandleSessionChanged()
    {
        LoadState();
        InvokeAsync(StateHasChanged);
    }

    private void LoadState()
    {
        LoadUnreadCount();
        LoadTournamentStats();
    }

    private void LoadTournamentStats()
    {
        loadError = null;

        try
        {
            TournamentDashboardDto overview = DashboardService.GetOverview();
            teamCount = overview.TeamCount;
            stadiumCount = overview.StadiumCount;
            totalMatches = overview.TotalMatches;
            playedMatches = overview.PlayedMatches;
            isFixtureGenerated = overview.IsFixtureGenerated;
            isKnockoutGenerated = overview.IsKnockoutGenerated;
            championName = overview.ChampionName;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while loading the tournament dashboard.");
            loadError = DashboardLoadErrorMessage;
        }
    }

    private void LoadUnreadCount()
    {
        unreadCount = Session.IsJournalist
            ? NotificationService.CountUnreadForUser(Session.CurrentUser!.idUser)
            : 0;
    }

    public void Dispose()
    {
        Session.OnChange -= HandleSessionChanged;
    }
}
