@page "/"
@using WorldCupPlanner.Domain
@using WorldCupPlanner.Services.Interfaces
@using WorldCupPlanner.Services.DTOs
@implements IDisposable
@inject SessionState Session
@inject INotificationService NotificationService
@inject ITournamentDashboardService DashboardService
@inject ILogger<Home> Logger

<PageTitle>Inicio · Golazo</PageTitle>

<section class="home-pitch" aria-labelledby="homeHeadline">
    <div class="pitch-copy">
        <p class="pitch-brand">Mundial 2026, 48 selecciones</p>
        <h1 id="homeHeadline" class="pitch-headline">@Headline</h1>
        <p class="pitch-lead" role="status">@TournamentStatusText</p>
        <div class="pitch-cta">
            @if (Session.IsLoggedIn)
            {
                <a class="btn btn-lg pitch-btn-main" href="@PrimaryCta.Href">
                    <i class="bi @PrimaryCta.Icon" aria-hidden="true"></i>
                    @PrimaryCta.Label
                </a>
                <a class="btn btn-lg pitch-btn-alt" href="/matches">Ver partidos</a>
            }
            else
            {
                <a class="btn btn-lg pitch-btn-main" href="/login">
                    <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                    Ingresar
                </a>
                <a class="btn btn-lg pitch-btn-alt" href="/signup">Crear cuenta</a>
            }
        </div>
    </div>
</section>

<ol class="stage-track" aria-label="Etapas del torneo">
    @for (int i = 0; i < Stages.Length; i++)
    {
        int index = i;
        <li class="stage @(index < CurrentStage ? "done" : index == CurrentStage ? "current" : "")"
            aria-current="@(index == CurrentStage ? "step" : null)">
            <span class="stage-name">@Stages[index]</span>
        </li>
    }
</ol>

@if (Session.IsLoggedIn && Session.IsJournalist && unreadCount > 0)
{
    <div class="alert alert-warning d-flex align-items-center gap-2 mt-4" role="alert">
        <i class="bi bi-bell-fill" aria-hidden="true"></i>
        <span>
            Tenés @unreadCount @(unreadCount == 1 ? "notificación sin leer" : "notificaciones sin leer").
        </span>
        <a class="alert-link" href="/notifications">Ver notificaciones</a>
    </div>
}

@if (!string.IsNullOrWhiteSpace(loadError))
{
    <div class="alert alert-error mt-4" role="alert">@loadError</div>
}

<dl class="tally">
    <div class="tally-item">
        <dt>Equipos</dt>
        <dd>@teamCount<span class="tally-of">/@RequiredTeamCount</span></dd>
    </div>
    <div class="tally-item">
        <dt>Estadios</dt>
        <dd>@stadiumCount</dd>
    </div>
    <div class="tally-item">
        <dt>Partidos jugados</dt>
        <dd>@playedMatches<span class="tally-of">/@totalMatches</span></dd>
    </div>
</dl>

<section class="how-it-works" aria-labelledby="howItWorksTitle">
    <h2 id="howItWorksTitle" class="how-title">Del sorteo a la final</h2>
    <ol class="how-steps">
        <li class="how-step">
            <h3>Equipos y sedes</h3>
            <p>Cargá las 48 selecciones a mano o por CSV, con bandera y ranking, y los estadios del torneo.</p>
        </li>
        <li class="how-step">
            <h3>Sorteo y fixture</h3>
            <p>12 grupos con cupos por confederación y un calendario reproducible gracias a la semilla.</p>
        </li>
        <li class="how-step">
            <h3>Simulación</h3>
            <p>Motores intercambiables juegan los partidos; también podés cargar cada resultado a mano.</p>
        </li>
        <li class="how-step">
            <h3>Hasta la final</h3>
            <p>De 16avos a la final, con penales, ranking Elo actualizado y un campeón del mundo.</p>
        </li>
    </ol>
</section>

@code {
    private const string DashboardLoadErrorMessage =
        "No se pudo cargar el resumen del torneo. Intentá nuevamente más tarde.";
    private const int RequiredTeamCount = 48;

    private int unreadCount;
    private int teamCount;
    private int stadiumCount;
    private int playedMatches;
    private int totalMatches;
    private bool isFixtureGenerated;
    private bool isKnockoutGenerated;
    private string? championName;
    private string? loadError;

    private sealed record CtaLink(string Label, string Href, string Icon);

    private bool CanManageTournament =>
        Session.CurrentUser?.HasRole(UserRoles.Admin) == true ||
        Session.CurrentUser?.HasRole(UserRoles.Editor) == true;

    private static readonly string[] Stages = { "Preparación", "Fase de grupos", "Eliminatorias", "Campeón" };

    private int CurrentStage =>
        championName is not null ? 3
        : isKnockoutGenerated ? 2
        : isFixtureGenerated ? 1
        : 0;

    private string Headline => CurrentStage switch
    {
        3 => $"{championName}, campeón del mundo.",
        2 => "Se juegan las eliminatorias.",
        1 => "La fase de grupos está en juego.",
        _ => "El Mundial se está armando."
    };

    private string TournamentStatusText => CurrentStage switch
    {
        3 => $"Se jugaron los {totalMatches} partidos. El cuadro completo está en el fixture y el ranking Elo final, en Ranking.",
        2 => "El cuadro eliminatorio ya está armado: de 16avos a la final, cada llave se define en un partido.",
        1 => $"Van {playedMatches} de {totalMatches} partidos. Los dos primeros de cada grupo y los ocho mejores terceros pasan a 16avos.",
        _ => $"Hay {teamCount} de {RequiredTeamCount} selecciones y {stadiumCount} estadios cargados. Con los 48 equipos se puede sortear el fixture."
    };

    private CtaLink PrimaryCta
    {
        get
        {
            if (!isFixtureGenerated && CanManageTournament)
            {
                return new CtaLink("Generar fixture", "/fixture", "bi-magic");
            }
            if (isFixtureGenerated && !isKnockoutGenerated && playedMatches < totalMatches && CanManageTournament)
            {
                return new CtaLink("Cargar resultados", "/fixture", "bi-pencil-square");
            }
            return new CtaLink("Ver fixture", "/fixture", "bi-diagram-3-fill");
        }
    }

    protected override void OnInitialized()
    {
        Session.OnChange += HandleSessionChanged;
        LoadState();
    }

    private void HandleSessionChanged()
    {
        LoadState();
        InvokeAsync(StateHasChanged);
    }

    private void LoadState()
    {
        LoadUnreadCount();
        LoadTournamentStats();
    }

    private void LoadTournamentStats()
    {
        loadError = null;

        try
        {
            TournamentDashboardDto overview = DashboardService.GetOverview();
            teamCount = overview.TeamCount;
            stadiumCount = overview.StadiumCount;
            totalMatches = overview.TotalMatches;
            playedMatches = overview.PlayedMatches;
            isFixtureGenerated = overview.IsFixtureGenerated;
            isKnockoutGenerated = overview.IsKnockoutGenerated;
            championName = overview.ChampionName;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while loading the tournament dashboard.");
            loadError = DashboardLoadErrorMessage;
        }
    }

    private void LoadUnreadCount()
    {
        unreadCount = Session.IsJournalist
            ? NotificationService.CountUnreadForUser(Session.CurrentUser!.idUser)
            : 0;
    }

    public void Dispose()
    {
        Session.OnChange -= HandleSessionChanged;
    }
}
