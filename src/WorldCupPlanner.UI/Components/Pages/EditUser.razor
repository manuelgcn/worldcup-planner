
@page "/edit-user"
@using WorldCupPlanner.Services
@using WorldCupPlanner.Services.Interfaces
@inject SessionState Session
@inject IUserService UserServices
@inject NavigationManager Nav

<PageTitle>Editar Usuario</PageTitle>

<section class="auth-wrap">
    <div class="m26-card auth-card">
        <div class="m26-card-header auth-head">
            <h1 class="auth-title mb-0">Mi perfil</h1>
        </div>
        <div class="auth-body">
            @if (errors.Any())
            {
                <div class="alert alert-error" role="alert">
                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                    Se encontraron errores:
                    <ul>
                        @foreach (string error in errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="alert alert-success" role="alert">
                    <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                    @successMessage
                </div>
            }

            @if (!Session.IsLoggedIn)
            {
                <p>No estás logueado.</p>
                <button class="btn btn-primary w-100" @onclick="GoToLogin">Ir a Login</button>
            }
            else
            {
                <p class="current-mail">
                    Email actual: <strong>@Session.CurrentUser!.email</strong>
                </p>

                <div class="mb-3">
                    <label class="form-label" for="editName">Nombre</label>
                    <input id="editName" class="form-control" placeholder="Nombre" @bind="name" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="editLastName">Apellido</label>
                    <input id="editLastName" class="form-control" placeholder="Apellido" @bind="lastname" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="editEmail">Email</label>
                    <input id="editEmail" class="form-control" placeholder="Email" @bind="email" />
                </div>

                <button class="btn btn-primary w-100" @onclick="Save">Guardar cambios</button>
            }
        </div>
    </div>
</section>

@code {
    private string name = "";
    private string lastname = "";
    private string email = "";
    private string? successMessage;
    private readonly List<string> errors = new List<string>();

    protected override void OnInitialized()
    {
        LoadCurrentUser();
    }

    private void LoadCurrentUser()
    {
        if (Session.CurrentUser is null)
            return;

        name = Session.CurrentUser.name;
        lastname = Session.CurrentUser.lastname ?? "";
        email = Session.CurrentUser.email;
    }

    private void Save()
    {
        errors.Clear();
        successMessage = null;

        if (!ValidateInput())
            return;

        try
        {
            UserServices.UpdateUser(
                Session.CurrentUser!.idUser,
                name,
                lastname,
                email,
                Session.CurrentUser?.email
            );

            successMessage = "Usuario actualizado correctamente";
        }
        catch (Exception ex)
        {
            errors.Add(ex.Message);
        }
    }

    private bool ValidateInput()
    {
        if (string.IsNullOrWhiteSpace(name))
            errors.Add("Nombre es obligatorio");

        if (string.IsNullOrWhiteSpace(lastname))
            errors.Add("Apellido es obligatorio");

        if (string.IsNullOrWhiteSpace(email))
            errors.Add("Email es obligatorio");
        else if (!email.Contains("@") || !email.Contains("."))
            errors.Add("Email invalido");

        return !errors.Any();
    }

    private void GoToLogin()
    {
        Nav.NavigateTo("/login");
    }
}
