
@page "/edit-user"
@using WorldCupPlanner.Services
@using WorldCupPlanner.Services.Interfaces
@inject SessionState Session
@inject IUserService UserServices

<PageTitle>Mi perfil · Golazo</PageTitle>

<section class="auth-wrap">
    <div class="m26-card auth-card">
        <div class="m26-card-header auth-head">
            <img class="auth-logo" src="img/golazo-mark.svg" alt="" width="56" height="56" />
            <h1 class="auth-title mb-0">Mi perfil</h1>
        </div>
        <div class="auth-body">
            @if (errors.Any())
            {
                <div class="alert alert-error" role="alert">
                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                    Se encontraron errores:
                    <ul>
                        @foreach (string error in errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="alert alert-success" role="alert">
                    <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                    @successMessage
                </div>
            }

            @if (!Session.IsLoggedIn)
            {
                <p class="mb-3">Ingresá para editar tu perfil.</p>
                <a class="btn btn-primary w-100" href="login">Ingresar</a>
            }
            else
            {
                <p class="current-mail">
                    Email actual: <strong>@Session.CurrentUser!.email</strong>
                </p>

                <form @onsubmit="Save">
                    <div class="mb-3">
                        <label class="form-label" for="editName">Nombre</label>
                        <input id="editName" class="form-control" autocomplete="given-name" placeholder="Nombre"
                               @bind="name" @bind:event="oninput" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="editLastName">Apellido</label>
                        <input id="editLastName" class="form-control" autocomplete="family-name" placeholder="Apellido"
                               @bind="lastname" @bind:event="oninput" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="editEmail">Email</label>
                        <input id="editEmail" class="form-control" type="email" autocomplete="email" placeholder="Email"
                               @bind="email" @bind:event="oninput" />
                    </div>

                    <button class="btn btn-primary w-100" type="submit">Guardar cambios</button>
                </form>
            }
        </div>
    </div>
</section>

@code {
    private string name = "";
    private string lastname = "";
    private string email = "";
    private string? successMessage;
    private readonly List<string> errors = new List<string>();

    protected override void OnInitialized()
    {
        LoadCurrentUser();
    }

    private void LoadCurrentUser()
    {
        if (Session.CurrentUser is null)
            return;

        name = Session.CurrentUser.name;
        lastname = Session.CurrentUser.lastname ?? "";
        email = Session.CurrentUser.email;
    }

    private void Save()
    {
        errors.Clear();
        successMessage = null;

        if (!ValidateInput())
            return;

        try
        {
            UserServices.UpdateUser(
                Session.CurrentUser!.idUser,
                name,
                lastname,
                email,
                Session.CurrentUser?.email
            );

            // La sesión guarda una copia del usuario: se recarga para que el layout y "Email actual" reflejen el cambio.
            Session.Login(UserServices.GetUserById(Session.CurrentUser!.idUser));
            successMessage = "Usuario actualizado correctamente";
        }
        catch (Exception ex)
        {
            errors.Add(ex.Message);
        }
    }

    private bool ValidateInput()
    {
        if (string.IsNullOrWhiteSpace(name))
            errors.Add("El nombre es obligatorio.");

        if (string.IsNullOrWhiteSpace(lastname))
            errors.Add("El apellido es obligatorio.");

        if (string.IsNullOrWhiteSpace(email))
            errors.Add("El email es obligatorio.");
        else if (!email.Contains("@") || !email.Contains("."))
            errors.Add("El email no es válido.");

        return !errors.Any();
    }
}
