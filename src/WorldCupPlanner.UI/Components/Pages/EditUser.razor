
@page "/edit-user"
@using WorldCupPlanner.Services
@using WorldCupPlanner.Services.Interfaces
@inject SessionState Session
@inject IUserService UserServices
@inject ILogger<EditUser> Logger

<PageTitle>Mi perfil · Golazo</PageTitle>

<section class="auth-wrap">
    <div class="m26-card auth-card">
        <div class="m26-card-header auth-head">
            <img class="auth-logo" src="img/golazo-mark.svg" alt="" width="56" height="56" />
            <h1 class="auth-title mb-0">Mi perfil</h1>
        </div>
        <div class="auth-body">
            @if (errors.Any())
            {
                <div class="alert alert-error" role="alert">
                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                    Se encontraron errores:
                    <ul>
                        @foreach (string error in errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="alert alert-success" role="alert">
                    <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                    @successMessage
                </div>
            }

            @if (!Session.IsLoggedIn)
            {
                <p class="mb-3">Ingresá para editar tu perfil.</p>
                <a class="btn btn-primary w-100" href="login">Ingresar</a>
            }
            else
            {
                <p class="current-mail">
                    Email actual: <strong>@Session.CurrentUser!.email</strong>
                </p>

                <form @onsubmit="Save">
                    <div class="mb-3">
                        <label class="form-label" for="editName">Nombre</label>
                        <input id="editName" class="form-control" autocomplete="given-name" placeholder="Nombre"
                               @bind="name" @bind:event="oninput" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="editLastName">Apellido</label>
                        <input id="editLastName" class="form-control" autocomplete="family-name" placeholder="Apellido"
                               @bind="lastname" @bind:event="oninput" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="editEmail">Email</label>
                        <input id="editEmail" class="form-control" type="email" autocomplete="email" placeholder="Email"
                               @bind="email" @bind:event="oninput" />
                    </div>

                    <button class="btn btn-primary w-100" type="submit">Guardar cambios</button>
                </form>
            }
        </div>
    </div>

    @if (Session.IsLoggedIn)
    {
        <div class="m26-card auth-card">
            <div class="auth-body">
                <h2 class="pane-title">Cambiar contraseña</h2>

                @if (Session.CurrentUser!.idUser == SystemAdminUserId)
                {
                    <p class="mb-0">La contraseña del administrador del sistema no se puede cambiar.</p>
                }
                else
                {
                    <FeedbackAlerts Errors="passwordErrors" SuccessMessage="@passwordSuccessMessage" />

                    <form @onsubmit="ChangePassword">
                        <div class="mb-3">
                            <label class="form-label" for="currentPassword">Contraseña actual</label>
                            <input id="currentPassword" class="form-control" type="password" autocomplete="current-password"
                                   @bind="currentPassword" @bind:event="oninput" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="newPassword">Contraseña nueva</label>
                            <input id="newPassword" class="form-control" type="password" autocomplete="new-password"
                                   aria-describedby="newPasswordHelp" @bind="newPassword" @bind:event="oninput" />
                            <div id="newPasswordHelp" class="form-text">De 8 a 128 caracteres, con mayúscula, minúscula, número y símbolo.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="repeatNewPassword">Repetir contraseña nueva</label>
                            <input id="repeatNewPassword" class="form-control" type="password" autocomplete="new-password"
                                   @bind="repeatNewPassword" @bind:event="oninput" />
                        </div>

                        <button class="btn btn-primary w-100" type="submit">Cambiar contraseña</button>
                    </form>
                }
            </div>
        </div>
    }
</section>

@code {
    private string name = "";
    private string lastname = "";
    private string email = "";
    private string? successMessage;
    private readonly List<string> errors = new List<string>();

    protected override void OnInitialized()
    {
        LoadCurrentUser();
    }

    private void LoadCurrentUser()
    {
        if (Session.CurrentUser is null)
            return;

        name = Session.CurrentUser.name;
        lastname = Session.CurrentUser.lastname ?? "";
        email = Session.CurrentUser.email;
    }

    private async Task Save()
    {
        errors.Clear();
        successMessage = null;

        if (!ValidateInput())
            return;

        try
        {
            UserServices.UpdateUser(
                Session.CurrentUser!.idUser,
                name,
                lastname,
                email,
                Session.CurrentUser?.email
            );

            // La sesión guarda una copia del usuario: se recarga para que el layout y "Email actual" reflejen el cambio.
            await Session.LoginAsync(UserServices.GetUserById(Session.CurrentUser!.idUser));
            successMessage = "Usuario actualizado correctamente";
        }
        catch (Exception ex)
        {
            errors.Add(UserFacingError.MessageFor(ex, Logger));
        }
    }

    private bool ValidateInput()
    {
        if (string.IsNullOrWhiteSpace(name))
            errors.Add("El nombre es obligatorio.");

        if (string.IsNullOrWhiteSpace(lastname))
            errors.Add("El apellido es obligatorio.");

        if (string.IsNullOrWhiteSpace(email))
            errors.Add("El email es obligatorio.");
        else if (!email.Contains("@") || !email.Contains("."))
            errors.Add("El email no es válido.");

        return !errors.Any();
    }

    // Mismo id reservado que UserServices: el servicio rechaza cambiarle la contraseña a esa cuenta.
    private const int SystemAdminUserId = 1;
    private const string MissingCurrentPasswordMessage = "Ingresá tu contraseña actual.";
    private const string MissingNewPasswordMessage = "Ingresá la contraseña nueva.";
    private const string NewPasswordsDoNotMatchMessage = "Las dos contraseñas nuevas no coinciden.";
    private const string PasswordChangedMessage = "Contraseña cambiada correctamente.";

    private string currentPassword = "";
    private string newPassword = "";
    private string repeatNewPassword = "";
    private string? passwordSuccessMessage;
    private readonly List<string> passwordErrors = new List<string>();

    private void ChangePassword()
    {
        passwordErrors.Clear();
        passwordSuccessMessage = null;

        // Se revisa antes de llamar al servicio: un error de tipeo al repetir no tiene que contar como intento fallido.
        if (Session.CurrentUser is null || !ValidatePasswordInput())
            return;

        try
        {
            UserServices.ChangePassword(Session.CurrentUser.idUser, currentPassword, newPassword);

            currentPassword = "";
            newPassword = "";
            repeatNewPassword = "";
            passwordSuccessMessage = PasswordChangedMessage;
        }
        catch (Exception ex)
        {
            passwordErrors.Add(UserFacingError.MessageFor(ex, Logger));
        }
    }

    private bool ValidatePasswordInput()
    {
        if (string.IsNullOrEmpty(currentPassword))
            passwordErrors.Add(MissingCurrentPasswordMessage);

        if (string.IsNullOrEmpty(newPassword))
            passwordErrors.Add(MissingNewPasswordMessage);
        else if (newPassword != repeatNewPassword)
            passwordErrors.Add(NewPasswordsDoNotMatchMessage);

        return !passwordErrors.Any();
    }
}
