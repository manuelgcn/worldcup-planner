@page "/ranking"
@using WorldCupPlanner.Domain
@using WorldCupPlanner.Services
@using WorldCupPlanner.Services.DTOs
@using WorldCupPlanner.Services.Interfaces
@inject ITeamService TeamServices
@inject IGroupStandingsService StandingsService
@inject SessionState Session

<PageTitle>Ranking FIFA · Golazo</PageTitle>

@if (!Session.IsLoggedIn)
{
    <h1 class="m26-page-title">Ranking FIFA</h1>
    <LoginRequired />
}
else
{
    <h1 class="m26-page-title">Ranking FIFA</h1>
    <p class="text-muted">Equipos ordenados por su ranking FIFA actual, con sus estadísticas de fase de grupos.</p>

    @if (!RankedTeams.Any())
    {
        <div class="m26-empty">
            <i class="bi bi-people" aria-hidden="true"></i>
            <p class="mb-0">No hay equipos cargados.</p>
        </div>
    }
    else
    {
        <div class="table-responsive m26-card table-wrap" tabindex="0" role="region" aria-label="Ranking FIFA">
            <table class="table table-hover m26-scoreboard mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Equipo</th>
                        <th>Confederación</th>
                        <th>Ranking FIFA</th>
                        <th title="Partidos jugados">PJ</th>
                        <th title="Ganados">G</th>
                        <th title="Empatados">E</th>
                        <th title="Perdidos">P</th>
                        <th title="Goles a favor">GF</th>
                        <th title="Goles en contra">GC</th>
                        <th title="Diferencia de gol">DG</th>
                        <th title="Puntos">Pts</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int position = 0;
                    }
                    @foreach (Team team in RankedTeams)
                    {
                        position++;
                        GroupStandingDto? stats = StatsFor(team);
                        <tr>
                            <td><span class="rank-pos @PodiumClass(position)">@position</span></td>
                            <td>
                                <TeamFlag Team="team" />
                                @team.Name
                                @if (team.IsFictitious)
                                {
                                    <span class="badge bg-secondary ms-1">Ficticio</span>
                                }
                            </td>
                            <td>
                                <span class="m26-conf-badge conf-@team.Confederation">@team.Confederation</span>
                            </td>
                            <td><strong>@team.FifaRanking</strong></td>
                            @if (stats is null)
                            {
                                <td colspan="8" class="text-muted">Sin fixture</td>
                            }
                            else
                            {
                                <td>@stats.GamesPlayed</td>
                                <td>@stats.Wins</td>
                                <td>@stats.Draws</td>
                                <td>@stats.Losses</td>
                                <td>@stats.GoalsFor</td>
                                <td>@stats.GoalsAgainst</td>
                                <td>@stats.GoalDifference</td>
                                <td><strong>@stats.Points</strong></td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private Dictionary<int, GroupStandingDto> statsByTeamId = new();

    private IEnumerable<Team> RankedTeams =>
        TeamServices.GetTeams()
            .OrderByDescending(team => team.FifaRanking)
            .ThenBy(team => team.Name);

    protected override void OnInitialized()
    {
        statsByTeamId = StandingsService.GetStandingsForAllGroups()
            .ToDictionary(standing => standing.Team.Id);
    }

    private static string PodiumClass(int position) => position switch
    {
        1 => "rank-gold",
        2 => "rank-silver",
        3 => "rank-bronze",
        _ => ""
    };

    private GroupStandingDto? StatsFor(Team team) =>
        statsByTeamId.GetValueOrDefault(team.Id);

}
