@using WorldCupPlanner.Domain
@using Microsoft.AspNetCore.Components.Routing
@using WorldCupPlanner.Services.Interfaces
@implements IDisposable
@inject SessionState Session
@inject INotificationService NotificationService
@inject NavigationManager Nav

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="brand-wrap" href="">
            <img class="brand-mark" src="img/golazo-mark.svg" alt="" width="40" height="40" />
            <span class="brand-text">
                <span class="navbar-brand">Golazo</span>
                <span class="brand-sub">Mundial 2026</span>
            </span>
        </a>
    </div>
</div>

<input type="checkbox" title="Menú de navegación" aria-label="Menú de navegación" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-house-door-fill" aria-hidden="true"></i> Inicio
            </NavLink>
        </div>

        @if (!Session.IsLoggedIn)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login">
                    <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Ingresar
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="signup">
                    <i class="bi bi-person-plus-fill" aria-hidden="true"></i> Crear cuenta
                </NavLink>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="edit-user">
                    <i class="bi bi-person-vcard-fill" aria-hidden="true"></i> Mi perfil
                </NavLink>
            </div>

            @if (Session.IsJournalist)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="notifications">
                        <i class="bi bi-bell" aria-hidden="true"></i> Notificaciones
                        @if (unreadCount > 0)
                        {
                            <span class="badge rounded-pill bg-danger ms-1">@unreadCount</span>
                        }
                    </NavLink>
                </div>
            }

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="fixture">
                    <i class="bi bi-diagram-3-fill" aria-hidden="true"></i> Fixture
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="matches">
                    <i class="bi bi-calendar-event-fill" aria-hidden="true"></i> Partidos
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="ranking">
                    <i class="bi bi-bar-chart-line-fill" aria-hidden="true"></i> Ranking
                </NavLink>
            </div>


            @if (IsAdmin || IsEditor)
            {
                <div class="nav-section">Gestión del torneo</div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="simulator">
                        <i class="bi bi-dice-5-fill" aria-hidden="true"></i> Simulador
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="import">
                        <i class="bi bi-upload" aria-hidden="true"></i> Importar
                    </NavLink>
                </div>
            }

            @if (IsAdmin)
            {
                <div class="nav-section">Administración</div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="teams">
                        <i class="bi bi-people-fill" aria-hidden="true"></i> Equipos
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="stadiums">
                        <i class="bi bi-geo-alt-fill" aria-hidden="true"></i> Estadios
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="users">
                        <i class="bi bi-person-gear" aria-hidden="true"></i> Usuarios
                    </NavLink>
                </div>
            }

            @if (IsAdmin || Session.IsJournalist)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="audit-log">
                        <i class="bi bi-journal-text" aria-hidden="true"></i> Log
                    </NavLink>
                </div>
            }

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="logout">
                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i> Cerrar sesión
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private int unreadCount;

    private bool IsAdmin =>
        Session.CurrentUser?.HasRole(UserRoles.Admin) == true;

    private bool IsEditor =>
        Session.CurrentUser?.HasRole(UserRoles.Editor) == true;

    protected override void OnInitialized()
    {
        Session.OnChange += HandleSessionChanged;
        Nav.LocationChanged += HandleLocationChanged;
        LoadUnreadCount();
    }

    private void HandleSessionChanged()
    {
        LoadUnreadCount();
        InvokeAsync(StateHasChanged);
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        LoadUnreadCount();
        InvokeAsync(StateHasChanged);
    }

    private void LoadUnreadCount()
    {
        unreadCount = Session.IsJournalist
            ? NotificationService.CountUnreadForUser(Session.CurrentUser!.idUser)
            : 0;
    }

    public void Dispose()
    {
        Session.OnChange -= HandleSessionChanged;
        Nav.LocationChanged -= HandleLocationChanged;
    }
}
