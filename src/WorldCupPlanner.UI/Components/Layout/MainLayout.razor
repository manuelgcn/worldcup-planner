@inherits LayoutComponentBase
@using WorldCupPlanner.Domain
@implements IDisposable
@inject SessionState Session

<div class="page">
    <header class="sidebar">
        <NavMenu/>
    </header>

    <main>
        <div class="top-row px-4">
            @if (Session.IsLoggedIn)
            {
                <a class="session-chip" href="edit-user" title="Mi perfil">
                    <span class="avatar" aria-hidden="true">@Initials</span>
                    <span class="session-text">
                        <span class="session-name">@Session.CurrentUser!.name @Session.CurrentUser.lastname</span>
                        <span class="session-role">@RoleLabel</span>
                    </span>
                </a>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" role="alert">
    Ocurrió un error inesperado.
    <a href="" class="reload">Recargar</a>
    <button type="button" class="dismiss" aria-label="Cerrar aviso">🗙</button>
</div>

@code {
    private string Initials =>
        $"{FirstLetter(Session.CurrentUser!.name)}{FirstLetter(Session.CurrentUser.lastname)}";

    private string RoleLabel =>
        Session.CurrentUser!.HasRole(UserRoles.Admin) ? "Administrador"
        : Session.CurrentUser.HasRole(UserRoles.Editor) ? "Editor"
        : "Periodista";

    private static string FirstLetter(string? text) =>
        string.IsNullOrWhiteSpace(text) ? "" : char.ToUpperInvariant(text.Trim()[0]).ToString();

    protected override void OnInitialized() => Session.OnChange += HandleSessionChanged;

    // Cada navegación cambia el Body: se relee el usuario para que un rol quitado o una baja hecha en
    // otra pestaña se apliquen ya, no recién al recargar.
    protected override Task OnParametersSetAsync() => Session.RevalidateAsync();

    private void HandleSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.OnChange -= HandleSessionChanged;
}
