# .gitignore for SolutionCopa
# Ignore build outputs
**/bin/
**/obj/

# Ignore test result folders
**/TestResults/
TestResults/

# Visual Studio / Rider files
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.DotSettings.user
*.DotSettings.user

# NuGet / packages
# Ignore packages folder if present and common NuGet artifacts
packages/
*.nupkg
project.assets.json
project.nuget.cache
project.packagespec.json
*.nuget.props
*.nuget.targets

# Rider / JetBrains
.idea/
/.idea/
*.sln.iml

# Dotnet publish
**/publish/

# Logs
*.log

# Coverage
*.coverage
*.coveragexml
coverage/**

# Temporary files
*.tmp
*.temp
~$*

# OS files
.DS_Store
Thumbs.db

# Generated by build systems / editor caches
*.rider.*
rider.project.model.nuget.info

# Ignore the test run folders seen in workspace
DomainTest/TestResults/
TestDomain/**/TestResults/

# Ignore any debug directories that sometimes appear
**/Debug/

# Ignore binary output in project directories (explicit)
Controllers/bin/
Controllers/obj/
DataAccess/bin/
DataAccess/obj/
Domain/bin/
Domain/obj/
Services/bin/
Services/obj/
UI/bin/
UI/obj/
TestDomain/**/bin/
TestDomain/**/obj/
DomainTest/bin/
DomainTest/obj/

