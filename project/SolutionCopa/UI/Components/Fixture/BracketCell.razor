@using ProjectCopa

<div class="bracket-cell @PlayedClass()">
    <div class="bracket-cell-code">@Match.MatchCode</div>
    <div class="bracket-cell-team @WinnerClass(true)">
        <span class="team-name"><TeamFlag Team="Match.HomeTeam" />@TeamName(Match.HomeTeam)</span>
        <span class="team-score">
            @Match.HomeGoals@if (Match.WonByPenalties)
            {
                <span class="penalty-score">(@Match.HomePenaltyGoals)</span>
            }
        </span>
    </div>
    <div class="bracket-cell-team @WinnerClass(false)">
        <span class="team-name"><TeamFlag Team="Match.AwayTeam" />@TeamName(Match.AwayTeam)</span>
        <span class="team-score">
            @Match.AwayGoals@if (Match.WonByPenalties)
            {
                <span class="penalty-score">(@Match.AwayPenaltyGoals)</span>
            }
        </span>
    </div>
    @if (Match.WonByPenalties)
    {
        <div class="bracket-cell-penalties">
            Pasa @PenaltyWinnerName() por penales @Match.HomePenaltyGoals-@Match.AwayPenaltyGoals
        </div>
    }
    @if (Match.Stadium != null)
    {
        <div class="bracket-cell-stadium">@Match.Stadium.Name</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public MatchElimination Match { get; set; } = null!;

    private string PlayedClass() => IsPlayed(Match) ? "played" : "pending";

    private string WinnerClass(bool isHome)
    {
        if (!IsPlayed(Match)) return "";
        Team? winner = Match.GetWinner();
        if (winner == null) return "";
        bool isWinner = isHome ? winner == Match.HomeTeam : winner == Match.AwayTeam;
        return isWinner ? "winner" : "loser";
    }

    private string PenaltyWinnerName()
    {
        Team? winner = Match.GetWinner();
        return winner?.Name ?? "TBD";
    }

    private static string TeamName(Team? team) => team?.Name ?? "TBD";

    private static bool IsPlayed(MatchElimination match) => match.WasSimulated || match.HomeGoals + match.AwayGoals > 0;
}
