@using ProjectCopa
@implements IDisposable
@inject SessionState Session

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <div class="brand-wrap">
            <span class="brand-mark">CP</span>
            <a class="navbar-brand" href="">COPA</a>
        </div>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-house-door-fill" aria-hidden="true"></i> Inicio
            </NavLink>
        </div>

        @if (!Session.IsLoggedIn)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login">
                    <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Ingresar
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="signup">
                    <i class="bi bi-person-plus-fill" aria-hidden="true"></i> Registrarme
                </NavLink>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="edit-user">
                    <i class="bi bi-person-vcard-fill" aria-hidden="true"></i> Mi perfil
                </NavLink>
            </div>
            
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="fixture">
                    <i class="bi bi-diagram-3-fill" aria-hidden="true"></i> Fixture
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="matches">
                    <i class="bi bi-calendar-event-fill" aria-hidden="true"></i> Partidos
                </NavLink>
            </div>


            @if (IsAdmin)
            {
                
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="simulator">
                        Simulator
                    </NavLink>
                </div>

                
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="stadiums">
                        <i class="bi bi-geo-alt-fill" aria-hidden="true"></i> Estadios
                    </NavLink>
                </div>
                
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="teams">
                        <i class="bi bi-people-fill" aria-hidden="true"></i> Equipos
                    </NavLink>
                </div>
                
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/users">
                        Usuarios
                    </NavLink>
                </div>

            }

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="logout">
                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i> Cerrar sesión
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private bool IsAdmin =>
        Session.CurrentUser!.Roles.Contains(UserRoles.Admin);

    protected override void OnInitialized()
    {
        Session.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Session.OnChange -= StateHasChanged;
    }
}