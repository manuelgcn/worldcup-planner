@page "/"
@using ProjectCopa
@using Services.Interfaces
@inject SessionState Session
@inject INotificationService NotificationService

<PageTitle>Inicio</PageTitle>

<section class="home-hero m26-card">
    <div class="hero-copy">
        <p class="hero-kicker">TORNEO INTERNACIONAL</p>
        <h1 class="hero-title">LA COPA</h1>
        <p class="hero-subtitle">
            48 selecciones, 16 sedes y 104 partidos.
        </p>
        <div class="hero-cta">
            @if (Session.IsLoggedIn)
            {
                <a class="btn btn-primary btn-lg" href="/fixture">
                    <i class="bi bi-diagram-3-fill" aria-hidden="true"></i>
                    Ver Fixture
                </a>
                <a class="btn btn-outline-primary btn-lg" href="/matches">
                    <i class="bi bi-calendar-event-fill" aria-hidden="true"></i>
                    Ver Partidos
                </a>
            }
            else
            {
                <a class="btn btn-primary btn-lg" href="/login">
                    <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                    Ingresar
                </a>
                <a class="btn btn-outline-primary btn-lg" href="/signup">
                    <i class="bi bi-person-plus-fill" aria-hidden="true"></i>
                    Registrarme
                </a>
            }
        </div>
    </div>
</section>

@if (Session.IsLoggedIn && Session.CurrentUser is not null && Session.CurrentUser.HasRole(UserRoles.Periodista))
{
    <section class="m26-card mt-4">
        <h2 class="pane-title">Notificaciones</h2>

        @if (!unreadNotifications.Any())
        {
            <div class="m26-empty">
                <i class="bi bi-bell" aria-hidden="true"></i>
                <p class="mb-0">No tenes notificaciones pendientes.</p>
            </div>
        }
        else
        {
            <ul class="list-group list-group-flush">
                @foreach (Notification notification in unreadNotifications)
                {
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <div>@notification.Message</div>
                                <small class="text-muted">
                                    @notification.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>

                            <button class="btn btn-sm btn-outline-primary"
                                    @onclick="() => MarkNotificationAsRead(notification.Id)">
                                Marcar como leida
                            </button>
                        </div>
                    </li>
                }
            </ul>
        }
    </section>
}

<section class="stats-grid">
    <article class="m26-card stat-card">
        <p class="stat-value">48</p>
        <p class="stat-label">Equipos</p>
    </article>
    <article class="m26-card stat-card">
        <p class="stat-value">16</p>
        <p class="stat-label">Estadios</p>
    </article>
    <article class="m26-card stat-card">
        <p class="stat-value">104</p>
        <p class="stat-label">Partidos</p>
    </article>
</section>

@code {
    private IReadOnlyCollection<Notification> unreadNotifications = Array.Empty<Notification>();

    protected override void OnInitialized()
    {
        LoadUnreadNotifications();
    }

    private void LoadUnreadNotifications()
    {
        if (!Session.IsLoggedIn || Session.CurrentUser is null)
        {
            unreadNotifications = Array.Empty<Notification>();
            return;
        }

        if (!Session.CurrentUser.HasRole(UserRoles.Periodista))
        {
            unreadNotifications = Array.Empty<Notification>();
            return;
        }

        unreadNotifications = NotificationService.GetUnreadForUser(Session.CurrentUser.idUser);
    }

    private void MarkNotificationAsRead(int notificationId)
    {
        if (Session.CurrentUser is null)
        {
            return;
        }

        NotificationService.MarkAsRead(notificationId, Session.CurrentUser.idUser);
        LoadUnreadNotifications();
        StateHasChanged();
    }
}
