@page "/import"
@using ProjectCopa
@using Services
@using Services.DTOs
@using Services.Interfaces
@inject IImportService ImportService
@inject SessionState Session
@inject NavigationManager Nav

<PageTitle>Importar equipos</PageTitle>

@if (!Session.IsLoggedIn)
{
    <section class="m26-card auth-card">
        <h1 class="m26-page-title mb-2">Importar equipos</h1>
        <p class="mb-3">No estás logueado.</p>
        <button class="btn btn-primary" @onclick="@(() => Nav.NavigateTo("/login"))">Ir a Login</button>
    </section>
}
else if (!IsAdmin)
{
    <div class="alert alert-error" role="alert">
        <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
        No tenés permisos para importar.
    </div>
}
else
{
    <h1 class="m26-page-title">Importar equipos (CSV)</h1>

    <article class="m26-card pane">
        <p>
            Subí un CSV con encabezados <code>Nombre, Confederación, RankingFIFA</code>.
            La importación se aborta ante el primer error (nombre vacío o &gt;60, confederación
            desconocida, ranking fuera de 300–2500, duplicado).
        </p>

        <InputFile OnChange="OnFileSelected" accept=".csv" class="form-control mb-3" />

        @if (result is not null)
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                <strong>@result.ImportedCount equipo(s) importado(s).</strong>
                @if (result.ImportedTeams.Any())
                {
                    <ul class="mb-0 mt-2">
                        @foreach (Team team in result.ImportedTeams)
                        {
                            <li>@team.Name (@team.Confederation, ranking @team.FifaRanking)</li>
                        }
                    </ul>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-error">
                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                @error
            </div>
        }
    </article>
}

@code {
    private ImportResult? result;
    private string? error;

    private bool IsAdmin =>
        Session.IsLoggedIn && Session.CurrentUser!.HasRole(UserRoles.Admin);

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        error = null;
        result = null;

        try
        {
            await using Stream upload = e.File.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using MemoryStream buffer = new MemoryStream();
            await upload.CopyToAsync(buffer);
            buffer.Position = 0;

            result = ImportService.ImportTeams(buffer);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}
