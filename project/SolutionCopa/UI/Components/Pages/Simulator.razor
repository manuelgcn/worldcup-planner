@page "/simulator"
@using ProjectCopa
@using Services.Interfaces
@inject ITournamentSimulationService TournamentSimulationService
@inject SessionState Session
@inject NavigationManager Nav

<PageTitle>Simulador de Torneo</PageTitle>

<div class="simulator-page">
    <h1 class="m26-page-title">Simulador de Torneo</h1>

    @if (!Session.IsLoggedIn)
    {
        <section class="m26-card auth-card">
            <p>No estás logueado.</p>
            <button class="btn btn-primary" @onclick="GoToLogin">
                <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                Ir a Login
            </button>
        </section>
    }
    else if (!IsAdmin)
    {
        <div class="alert alert-error">
            <i class="bi bi-shield-lock" aria-hidden="true"></i>
            No tenés permisos para simular el torneo.
        </div>
    }
    else
    {
        @if (errors.Any())
        {
            <div class="alert alert-error">
                <strong>Error:</strong>
                <ul>
                    @foreach (string error in errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>@successMessage
            </div>
        }

        <div class="alert alert-info">
            <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
            Esta acción simula los 72 partidos de la fase de grupos y genera los cruces de fase 2 de una sola vez.
            Para hacerlo paso a paso, usá la página de <a href="/fixture">Fixture</a>.
        </div>

        <div class="sim-grid">
            <section class="m26-card sim-card">
                <div class="m26-card-header">
                    <h2 class="sim-card-title">
                        <i class="bi bi-dice-5-fill" aria-hidden="true"></i>
                        Simulación determinística
                    </h2>
                </div>
                <div class="sim-card-body">
                    <p class="sim-help">Reproducible: la misma semilla siempre produce el mismo torneo.</p>
                    <label for="seedInput">Semilla</label>
                    <input id="seedInput" class="form-control" type="number" @bind="seed" placeholder="0" />
                    <button class="btn btn-primary" disabled="@isBusy" @onclick="SimulateWithSeedAsync">
                        <i class="bi @(isBusy ? "bi-arrow-repeat spin" : "bi-play-fill")" aria-hidden="true"></i>
                        Simular con semilla
                    </button>
                </div>
            </section>

            <section class="m26-card sim-card">
                <div class="m26-card-header">
                    <h2 class="sim-card-title">
                        <i class="bi bi-shuffle" aria-hidden="true"></i>
                        Simulación aleatoria
                    </h2>
                </div>
                <div class="sim-card-body">
                    <p class="sim-help">Usa una semilla al azar. El resultado queda igualmente registrado en el log.</p>
                    <button class="btn btn-secondary" disabled="@isBusy" @onclick="SimulateRandomAsync">
                        <i class="bi @(isBusy ? "bi-arrow-repeat spin" : "bi-shuffle")" aria-hidden="true"></i>
                        Simular aleatorio
                    </button>
                </div>
            </section>
        </div>
    }
</div>

@code {
    private int seed;
    private bool isBusy;
    private readonly List<string> errors = new();
    private string? successMessage;

    private bool IsAdmin =>
        Session.CurrentUser?.HasRole(UserRoles.Admin) == true;

    private async Task SimulateWithSeedAsync()
    {
        await RunSimulationAsync(seed, $"Torneo simulado correctamente con semilla {seed}.");
    }

    private async Task SimulateRandomAsync()
    {
        int randomSeed = new Random().Next();
        await RunSimulationAsync(randomSeed, $"Torneo simulado correctamente (semilla aleatoria {randomSeed}).");
    }

    private async Task RunSimulationAsync(int simulationSeed, string successText)
    {
        errors.Clear();
        successMessage = null;
        isBusy = true;
        try
        {
            await Task.Run(() => TournamentSimulationService.SimulateGroupStageAndGenerateKnockout(simulationSeed));
            successMessage = successText;
        }
        catch (Exception ex)
        {
            errors.Add(ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private void GoToLogin()
    {
        Nav.NavigateTo("/login");
    }
}
