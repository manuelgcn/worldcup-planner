@page "/stadiums"
@using ProjectCopa
@using Services.Exceptions
@using Services.Interfaces
@inject IStadiumService StadiumServices
@inject SessionState Session
@inject NavigationManager Nav

<PageTitle>Estadios</PageTitle>

@if (!Session.IsLoggedIn)
{
    <section class="m26-card auth-card">
        <h1 class="m26-page-title mb-2">Estadios</h1>
        <p class="mb-3">No estás logueado.</p>
        <button class="btn btn-primary" @onclick="GoToLogin">
            <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
            Ir a Login
        </button>
    </section>
}
else if (!IsAdmin)
{
    <div class="alert alert-error" role="alert">
        <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
        No tenés permisos para administrar estadios.
    </div>
}
else
{
    <h1 class="m26-page-title">Estadios</h1>

    <FeedbackAlerts Errors="errors" SuccessMessage="@successMessage" />

    <section class="admin-grid">
        <article class="m26-card pane">
            <h2 class="pane-title">Crear estadio</h2>

            <div class="mb-3">
                <label class="form-label" for="stadiumName">Nombre</label>
                <input id="stadiumName" class="form-control" placeholder="Nombre" @bind="name" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="stadiumCity">Ciudad</label>
                <input id="stadiumCity" class="form-control" placeholder="Ciudad" @bind="city" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="stadiumDesc">Descripción (opcional)</label>
                <input id="stadiumDesc" class="form-control" placeholder="Descripción (opcional)" @bind="description" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="stadiumCapacity">Capacidad</label>
                <input id="stadiumCapacity" class="form-control" placeholder="Capacidad" type="number" @bind="capacity" />
            </div>

            <button class="btn btn-primary" @onclick="Create">
                <i class="bi bi-plus-circle-fill" aria-hidden="true"></i>
                Crear
            </button>
        </article>

        <article class="m26-card pane">
            <h2 class="pane-title">Estadios existentes</h2>

            @if (!stadiums.Any())
            {
                <div class="m26-empty">
                    <i class="bi bi-geo-alt" aria-hidden="true"></i>
                    <p class="mb-0">No hay estadios cargados.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover m26-scoreboard mb-0">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Ciudad</th>
                                <th>Capacidad</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (ProjectCopa.Stadium stadium in stadiums)
                            {
                                <tr>
                                    <td>@stadium.Name</td>
                                    <td>@stadium.City</td>
                                    <td>@stadium.Capacity</td>
                                    <td class="text-end">
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => Remove(stadium.Id)">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                            Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </article>
    </section>
}

@code {
    private string name = "";
    private string city = "";
    private string? description;
    private int capacity;

    private readonly List<string> errors = new List<string>();
    private string? successMessage;

    private IReadOnlyCollection<ProjectCopa.Stadium> stadiums = Array.Empty<ProjectCopa.Stadium>();

    private bool IsAdmin =>
        Session.CurrentUser!.HasRole(UserRoles.Admin);

    protected override void OnInitialized()
    {
        LoadStadiums();
    }

    private void LoadStadiums()
    {
        stadiums = StadiumServices.GetAllStadiums();
    }

    private void Create()
    {
        errors.Clear();
        successMessage = null;

        if (!ValidateInput())
            return;

        try
        {
            ProjectCopa.Stadium stadium = new ProjectCopa.Stadium(
                name,
                city,
                description,
                capacity
            );

            StadiumServices.AddStadium(stadium);
            successMessage = "Estadio creado correctamente";
            ClearForm();
            LoadStadiums();
        }
        catch (StadiumServicesException ex)
        {
            errors.Add(ex.Message);
        }
        catch (ArgumentException ex)
        {
            errors.Add(ex.Message);
        }
    }

    private void Remove(int id)
    {
        errors.Clear();
        successMessage = null;

        try
        {
            StadiumServices.RemoveById(id);
            successMessage = "Estadio eliminado correctamente";
            LoadStadiums();
        }
        catch (StadiumServicesException ex)
        {
            errors.Add(ex.Message);
        }
        catch (ArgumentException ex)
        {
            errors.Add(ex.Message);
        }
    }

    private bool ValidateInput()
    {
        if (string.IsNullOrWhiteSpace(name))
            errors.Add("El nombre es obligatorio");

        if (string.IsNullOrWhiteSpace(city))
            errors.Add("La ciudad es obligatoria");

        if (capacity < 20000)
            errors.Add("La capacidad debe ser al menos 20000");

        return !errors.Any();
    }

    private void ClearForm()
    {
        name = "";
        city = "";
        description = null;
        capacity = 0;
    }

    private void GoToLogin()
    {
        Nav.NavigateTo("/login");
    }
}
