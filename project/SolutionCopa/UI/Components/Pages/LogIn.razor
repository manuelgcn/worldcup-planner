@page "/login"
@using ProjectCopa
@using Services
@using Services.Interfaces
@inject IUserService UserServices
@inject SessionState Session
@inject NavigationManager Nav

<PageTitle>Ingresar</PageTitle>

<section class="auth-wrap">
    <div class="m26-card auth-card">
        <div class="m26-card-header auth-head">
            <h1 class="auth-title mb-0">Ingresar</h1>
        </div>
        <div class="auth-body">

            @if (errors.Count > 0)
            {
                <div class="alert alert-error" role="alert">
                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                    Revisá los siguientes errores:
                    <ul>
                        @foreach (string error in errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }

            <div class="mb-3">
                <label class="form-label" for="loginEmail">Email</label>
                <input id="loginEmail" class="form-control" placeholder="tu@email.com" @bind="email" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="loginPassword">Contraseña</label>
                <input id="loginPassword" class="form-control" placeholder="••••••••" type="password" @bind="password" />
            </div>

            <button class="btn btn-primary w-100" @onclick="Login">
                Ingresar
            </button>

            <!-- ========================= -->
            <!-- TESTEO FUNCIONAL -->
            <!-- ========================= -->
            <hr />

            <div class="alert alert-info" role="alert">
                <strong>Credenciales de prueba (solo para testeo funcional) NO MODIFICAR:</strong>
                <ul class="mb-0">
                    <li>
                        <strong>Administrador</strong><br />
                        Email: <code>admin@copa.com</code><br />
                        Password: <code>Admin@123</code>
                    </li>
                    <li class="mt-2">
                        <strong>Editor</strong><br />
                        Email: <code>editor@copa.com</code><br />
                        Password: <code>Editor@123</code>
                    </li>
                    <li class="mt-2">
                        <strong>Periodista</strong><br />
                        Email: <code>periodista@copa.com</code><br />
                        Password: <code>Periodista@123</code>
                    </li>
                </ul>
            </div>

        </div>
    </div>
</section>

@code {
    private string email = "";
    private string password = "";
    private readonly List<string> errors = new();

    private void Login()
    {
        errors.Clear();

        try
        {
            ValidateInput();

            User user = UserServices.Authenticate(email, password);

            Session.Login(user);
            Nav.NavigateTo(HomeRouteFor(user));
        }
        catch (Exception ex)
        {
            errors.Add(ex.Message);
        }
    }

    // El Periodista aterriza en sus notificaciones; el resto en el inicio.
    private static string HomeRouteFor(User user) =>
        user.HasRole(UserRoles.Periodista) && !user.HasRole(UserRoles.Admin) && !user.HasRole(UserRoles.Editor)
            ? "/notifications"
            : "/";

    private void ValidateInput()
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            errors.Add("Email es obligatorio");
        }

        if (string.IsNullOrWhiteSpace(password))
        {
            errors.Add("Password es obligatorio");
        }

        if (errors.Count > 0)
        {
            throw new ArgumentException("Corrige los errores del formulario");
        }
    }
}