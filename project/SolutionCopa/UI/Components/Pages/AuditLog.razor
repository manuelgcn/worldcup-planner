@page "/audit-log"
@using ProjectCopa
@using Services
@using Services.DTOs
@using Services.Exceptions
@using Services.Interfaces
@using Microsoft.JSInterop
@inject IAuditLogService AuditLogService
@inject IExportService ExportService
@inject SessionState Session
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Log de auditoría</PageTitle>

@if (!Session.IsLoggedIn)
{
    <section class="m26-card auth-card">
        <h1 class="m26-page-title mb-2">Log de auditoría</h1>
        <p class="mb-3">No estás logueado.</p>
        <button class="btn btn-primary" @onclick="@(() => Nav.NavigateTo("/login"))">Ir a Login</button>
    </section>
}
else if (!CanExport)
{
    <div class="alert alert-error" role="alert">
        <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
        No tenés permisos para ver el log.
    </div>
}
else
{
    <h1 class="m26-page-title">Log de auditoría</h1>

    <div class="d-flex flex-wrap gap-2 mb-3">
        <input class="form-control filter-action"
               placeholder="Filtrar por acción (ej: CREATE_USER)"
               aria-label="Filtrar por acción"
               @bind="actionFilter" @bind:event="oninput" />
        <input class="form-control filter-date" type="date" aria-label="Desde" @bind="fromDate" />
        <input class="form-control filter-date" type="date" aria-label="Hasta" @bind="toDate" />
        <button class="btn btn-outline-secondary" @onclick="ClearFilters">
            <i class="bi bi-x-circle" aria-hidden="true"></i> Limpiar
        </button>
        <select class="form-select filter-action" aria-label="Formato de exportación" @bind="exportFormat">
            <option value="@ExportFormat.Csv">CSV</option>
            <option value="@ExportFormat.Xlsx">XLSX</option>
        </select>
        <button class="btn btn-outline-primary" disabled="@isExporting" @onclick="ExportAsync">
            <i class="bi bi-download" aria-hidden="true"></i> Exportar log
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(exportError))
    {
        <div class="alert alert-error" role="alert">@exportError</div>
    }

    <article class="m26-card pane">
        @if (!Filtered.Any())
        {
            <div class="m26-empty">
                <i class="bi bi-journal-x" aria-hidden="true"></i>
                <p class="mb-0">No hay registros que coincidan.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table m26-scoreboard mb-0">
                    <thead>
                        <tr>
                            <th>Timestamp</th>
                            <th>Acción</th>
                            <th>Entidad</th>
                            <th>ID</th>
                            <th>Detalle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (AuditLogDto log in Filtered)
                        {
                            <tr>
                                <td>@log.Timestamp.ToString("o")</td>
                                <td><span class="m26-conf-badge">@log.Action</span></td>
                                <td>@(log.EntityType ?? "—")</td>
                                <td>@(log.EntityId?.ToString() ?? "—")</td>
                                <td>@log.Details</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </article>
}

@code {
    private string actionFilter = "";
    private DateTime? fromDate;
    private DateTime? toDate;

    private ExportFormat exportFormat = ExportFormat.Csv;
    private bool isExporting;
    private string? exportError;

    private bool CanExport =>
        Session.IsLoggedIn &&
        (Session.CurrentUser!.HasRole(UserRoles.Admin) || Session.CurrentUser.HasRole(UserRoles.Periodista));

    private IEnumerable<AuditLogDto> Filtered =>
        AuditLogService.GetAll()
            .Where(l => string.IsNullOrWhiteSpace(actionFilter)
                || l.Action.Contains(actionFilter, StringComparison.OrdinalIgnoreCase))
            .Where(l => !fromDate.HasValue || l.Timestamp.Date >= fromDate.Value.Date)
            .Where(l => !toDate.HasValue || l.Timestamp.Date <= toDate.Value.Date)
            .OrderByDescending(l => l.Timestamp);

    private void ClearFilters()
    {
        actionFilter = "";
        fromDate = null;
        toDate = null;
        exportError = null;
    }

    private async Task ExportAsync()
    {
        exportError = null;
        isExporting = true;
        try
        {
            List<AuditLogDto> logs = AuditLogService.GetAll();
            DateTime defaultDate = DateTime.UtcNow.Date;
            DateTime exportFrom = fromDate?.Date ?? logs.Select(log => log.Timestamp.Date).DefaultIfEmpty(defaultDate).Min();
            DateTime exportTo = toDate?.Date ?? logs.Select(log => log.Timestamp.Date).DefaultIfEmpty(defaultDate).Max();
            ExportFileDto file = ExportService.ExportAuditLog(
                new DateRange(exportFrom, exportTo),
                exportFormat,
                Session.CurrentUser!);

            await JS.InvokeVoidAsync(
                "downloadExportFile",
                file.FileName,
                file.ContentType,
                Convert.ToBase64String(file.Content));
        }
        catch (ExportServiceException ex)
        {
            exportError = ex.Message;
        }
        finally
        {
            isExporting = false;
        }
    }
}
