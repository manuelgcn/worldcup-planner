@page "/matches"
@using ProjectCopa
@using Services.DTOs
@using Services.Exceptions
@using Services.Interfaces
@inject IMatchQueryService MatchQuery
@inject IMatchService MatchService
@inject IKnockoutFixtureGenerator KnockoutGenerator
@inject IStadiumService StadiumServices
@inject SessionState Session
@inject NavigationManager Nav

<PageTitle>Partidos</PageTitle>

@if (!Session.IsLoggedIn)
{
    <section class="m26-card auth-card">
        <h1 class="m26-page-title mb-2">Partidos</h1>
        <p class="mb-3">No estas logueado.</p>
        <button class="btn btn-primary" @onclick="GoToLogin">
            <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
            Ir a Login
        </button>
    </section>
}
else
{
    <h1 class="m26-page-title">Partidos</h1>

    @if (errors.Any())
    {
        <div class="alert alert-error" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            Se encontraron errores:
            <ul>
                @foreach (var error in errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success" role="alert">
            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
            @successMessage
        </div>
    }

    <section class="m26-card filters-card">
        <div class="filters-grid">
            <div class="filter-item">
                <label class="form-label">Desde</label>
                <input class="form-control" type="date" @bind="filterFrom" />
            </div>
            <div class="filter-item">
                <label class="form-label">Hasta</label>
                <input class="form-control" type="date" @bind="filterTo" />
            </div>
            <div class="filter-item">
                <label class="form-label">Estadio</label>
                <select class="form-select" @bind="filterStadiumId">
                    <option value="0">-- Todos --</option>
                    @foreach (ProjectCopa.Stadium s in stadiums)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
            </div>
            <div class="filter-item">
                <label class="form-label">Grupo</label>
                <select class="form-select" @bind="filterGroup">
                    <option value="">-- Todos --</option>
                    @foreach (string g in groupOptions)
                    {
                        <option value="@g">@g</option>
                    }
                </select>
            </div>
            <div class="filter-item">
                <label class="form-label">Fase</label>
                <select class="form-select" @bind="FilterPhaseSelection">
                    <option value="">-- Todas --</option>
                    @foreach (Phase p in Enum.GetValues<Phase>())
                    {
                        <option value="@p">@p</option>
                    }
                </select>
            </div>
            <div class="filter-actions">
                <button class="btn btn-primary" @onclick="ApplyFilters">
                    <i class="bi bi-funnel-fill" aria-hidden="true"></i>
                    Filtrar
                </button>
                <button class="btn btn-outline-primary" @onclick="ClearFilters">
                    <i class="bi bi-eraser-fill" aria-hidden="true"></i>
                    Limpiar
                </button>
            </div>
        </div>
    </section>

    <div class="section-separator"></div>

    @if (matches.Any())
    {
        <h2 class="section-title">Partidos filtrados</h2>
        <div class="table-responsive m26-card table-wrap">
            <table class="table table-hover m26-scoreboard mb-0">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Grupo / Fase</th>
                        <th>Equipos</th>
                        <th>Estadio</th>
                        <th>Resultado</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (MatchListItemDto match in matches)
                    {
                        <tr>
                            <td>@match.MatchDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@StageLabel(match)</td>
                            <td>@match.HomeTeamName vs @match.AwayTeamName</td>
                            <td>@match.StadiumName</td>
                            <td>@match.HomeGoals - @match.AwayGoals</td>
                            <td>
                                <span class="match-status @(IsPlayed(match) ? "played" : "pending")">
                                    @(IsPlayed(match) ? "Finalizado" : "Pendiente")
                                </span>
                            </td>
                            <td>
                                @if (CanEditRow(match))
                                {
                                    <button class="btn btn-outline-primary btn-sm"
                                            disabled="@(editingMatchId == match.MatchId)"
                                            @onclick="() => StartEdit(match)">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                        Editar
                                    </button>
                                }
                                else if (CanEditMatches && IsGroupStageLocked && match.GroupName is not null)
                                {
                                    <span class="text-muted" title="La fase de grupos está cerrada: los cruces de fase 2 ya fueron generados.">
                                        <i class="bi bi-lock-fill" aria-hidden="true"></i>
                                    </span>
                                }
                            </td>
                        </tr>
                        @if (editingMatchId == match.MatchId && editingMatch is not null)
                        {
                            <tr class="row-editing">
                                <td colspan="7">
                                    <MatchResultEditor Match="editingMatch"
                                                       ShowDateAndStadium="true"
                                                       OnSaved="HandleSaved"
                                                       OnCancel="CancelEdit" />
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="m26-empty">
            <i class="bi bi-calendar-x" aria-hidden="true"></i>
            <p class="mb-0">No hay partidos para los filtros seleccionados.</p>
        </div>
    }
}

@code {
    private static readonly string[] groupOptions =
        Enumerable.Range(0, 12).Select(i => ((char)('A' + i)).ToString()).ToArray();

    [SupplyParameterFromQuery(Name = "grupo")]
    public string? GrupoQueryParam { get; set; }

    [SupplyParameterFromQuery(Name = "fase")]
    public string? FaseQueryParam { get; set; }

    private DateTime? filterFrom;
    private DateTime? filterTo;
    private int filterStadiumId;
    private string filterGroup = "";
    private Phase? filterPhase;

    private string FilterPhaseSelection
    {
        get => filterPhase?.ToString() ?? "";
        set => filterPhase = string.IsNullOrEmpty(value) ? null : Enum.Parse<Phase>(value);
    }

    private List<MatchListItemDto> matches = new();
    private IReadOnlyCollection<ProjectCopa.Stadium> stadiums = Array.Empty<ProjectCopa.Stadium>();

    private readonly List<string> errors = new();
    private string? successMessage;

    private int? editingMatchId;
    private Match? editingMatch;

    private bool CanEditMatches =>
        Session.IsLoggedIn &&
        Session.CurrentUser is not null &&
        (Session.CurrentUser.HasRole(UserRoles.Admin) || Session.CurrentUser.HasRole(UserRoles.Editor));

    private bool IsGroupStageLocked => KnockoutGenerator.IsBracketGenerated();

    protected override void OnInitialized()
    {
        ApplyQueryParameters();
        LoadStadiums();
        ApplyFilters();
    }

    private void ApplyQueryParameters()
    {
        if (!string.IsNullOrWhiteSpace(GrupoQueryParam) && groupOptions.Contains(GrupoQueryParam.ToUpperInvariant()))
        {
            filterGroup = GrupoQueryParam.ToUpperInvariant();
        }

        if (!string.IsNullOrWhiteSpace(FaseQueryParam) && Enum.TryParse(FaseQueryParam, ignoreCase: true, out Phase parsedPhase))
        {
            filterPhase = parsedPhase;
        }
    }

    // Un partido es de grupos si tiene grupo; los de eliminacion no se congelan.
    private bool CanEditRow(MatchListItemDto match)
    {
        if (!CanEditMatches)
        {
            return false;
        }

        return match.GroupName is null || !IsGroupStageLocked;
    }

    private static bool IsPlayed(MatchListItemDto match) => match.HasResult;

    private static string StageLabel(MatchListItemDto match) =>
        match.GroupName is not null
            ? $"Grupo {match.GroupName}"
            : match.Phase?.ToString() ?? "";

    private void ApplyFilters()
    {
        errors.Clear();
        successMessage = null;
        matches.Clear();
        CancelEdit();

        try
        {
            MatchFilterDto filter = new MatchFilterDto
            {
                From = filterFrom,
                To = filterTo,
                StadiumId = filterStadiumId > 0 ? filterStadiumId : null,
                GroupName = string.IsNullOrEmpty(filterGroup) ? null : filterGroup,
                Phase = filterPhase
            };

            matches = MatchQuery.Search(filter).ToList();
        }
        catch (MatchServicesException ex)
        {
            errors.Add(ex.Message);
        }
        catch (ArgumentException ex)
        {
            errors.Add(ex.Message);
        }
    }

    private void ClearFilters()
    {
        filterFrom = null;
        filterTo = null;
        filterStadiumId = 0;
        filterGroup = "";
        filterPhase = null;
        ApplyFilters();
    }

    private void LoadStadiums()
    {
        try
        {
            stadiums = StadiumServices.GetAllStadiums();
        }
        catch (StadiumServicesException ex)
        {
            errors.Add(ex.Message);
        }
        catch (ArgumentException ex)
        {
            errors.Add(ex.Message);
        }
    }

    private void StartEdit(MatchListItemDto match)
    {
        errors.Clear();
        successMessage = null;

        try
        {
            // El editor opera sobre la entidad; la pagina la pide al servicio en vez de tocar repositorios.
            editingMatch = MatchService.GetEntity(match.MatchId);
            editingMatchId = match.MatchId;
        }
        catch (MatchServicesException ex)
        {
            errors.Add(ex.Message);
        }
    }

    private void CancelEdit()
    {
        editingMatchId = null;
        editingMatch = null;
    }

    private void HandleSaved(string message)
    {
        CancelEdit();
        ApplyFilters();
        successMessage = message;
    }

    private void GoToLogin()
    {
        Nav.NavigateTo("/login");
    }
}
