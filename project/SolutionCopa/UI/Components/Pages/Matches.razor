@page "/matches"
@using ProjectCopa
@using Services.Exceptions
@using Services.Interfaces
@using DataAccess.Interfaces
@inject IMatchRepository MatchRepository
@inject IEliminationMatchRepository EliminationRepository
@inject IUnitOfWork UnitOfWork
@inject IStadiumService StadiumServices
@inject SessionState Session
@inject NavigationManager Nav

<PageTitle>Partidos</PageTitle>

@if (!Session.IsLoggedIn)
{
    <section class="m26-card auth-card">
        <h1 class="m26-page-title mb-2">Partidos</h1>
        <p class="mb-3">No estás logueado.</p>
        <button class="btn btn-primary" @onclick="GoToLogin">
            <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
            Ir a Login
        </button>
    </section>
}
else
{
    <h1 class="m26-page-title">PARTIDOS</h1>

    @if (errors.Any())
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            Se encontraron errores:
            <ul>
                @foreach (var error in errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success" role="alert">
            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
            @successMessage
        </div>
    }

    <section class="m26-card filters-card">
        <div class="filters-grid">
            <div class="filter-item">
                <label class="form-label">Desde</label>
                <input class="form-control" type="date" @bind="filterFrom" />
            </div>
            <div class="filter-item">
                <label class="form-label">Hasta</label>
                <input class="form-control" type="date" @bind="filterTo" />
            </div>
            <div class="filter-item">
                <label class="form-label">Estadio</label>
                <select class="form-select" @bind="filterStadiumId">
                    <option value="0">-- Todos --</option>
                    @foreach (ProjectCopa.Stadium s in stadiums)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
            </div>
            <div class="filter-item">
                <label class="form-label">Grupo</label>
                <select class="form-select" @bind="filterGroup">
                    <option value="">-- Todos --</option>
                    @foreach (string g in groupOptions)
                    {
                        <option value="@g">@g</option>
                    }
                </select>
            </div>
            <div class="filter-item">
                <label class="form-label">Fase</label>
                <select class="form-select" @bind="FilterPhaseSelection">
                    <option value="">-- Todas --</option>
                    @foreach (Phase p in Enum.GetValues<Phase>())
                    {
                        <option value="@p">@p</option>
                    }
                </select>
            </div>
            <div class="filter-actions">
                <button class="btn btn-primary" @onclick="ApplyFilters">
                    <i class="bi bi-funnel-fill" aria-hidden="true"></i>
                    Filtrar
                </button>
                <button class="btn btn-outline-primary" @onclick="ClearFilters">
                    <i class="bi bi-eraser-fill" aria-hidden="true"></i>
                    Limpiar
                </button>
            </div>
        </div>
    </section>

    <div class="section-separator"></div>

    @if (matches.Any())
    {
        <h2 class="section-title">Partidos filtrados</h2>
        <div class="table-responsive m26-card table-wrap">
            <table class="table table-hover m26-scoreboard mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Fecha</th>
                        <th>Equipos</th>
                        <th>Estadio</th>
                        <th>Resultado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Match match in matches)
                    {
                        @if (editingMatchId == match.MatchId)
                        {
                            <tr class="row-editing">
                                <td>@match.MatchId</td>
                                <td>
                                    <input class="form-control" type="datetime-local" @bind="editingMatchDate" />
                                </td>
                                <td>
                                    @match.HomeTeam?.Name vs @match.AwayTeam?.Name
                                </td>
                                <td>
                                    <select class="form-select" @bind="editingStadiumId">
                                        <option value="0">-- Seleccione estadio --</option>
                                        @foreach (var stadium in stadiums)
                                        {
                                            <option value="@stadium.Id">@stadium.Name</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input class="form-control goal-input" type="number" @bind="editingHomeGoals" min="0" />
                                    -
                                    <input class="form-control goal-input" type="number" @bind="editingAwayGoals" min="0" />
                                </td>

                                <td>
                                    <button class="btn btn-success btn-sm me-1" @onclick="() => SaveEdit(match)">
                                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                                        Guardar
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="CancelEdit">
                                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                                        Cancelar
                                    </button>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td>@match.MatchId</td>
                                <td>@match.MatchDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@match.HomeTeam?.Name vs @match.AwayTeam?.Name</td>
                                <td>@match.Stadium?.Name</td>
                                <td>@match.HomeGoals - @match.AwayGoals</td>

                                <td>
                                    <button class="btn btn-outline-primary btn-sm" @onclick="() => StartEdit(match)">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                        Editar
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="m26-empty">
            <i class="bi bi-calendar-x" aria-hidden="true"></i>
            <p class="mb-0">No hay partidos para los filtros seleccionados.</p>
        </div>
    }
}

@code {
    private static readonly string[] groupOptions =
        Enumerable.Range(0, 12).Select(i => ((char)('A' + i)).ToString()).ToArray();

    private DateTime? filterFrom;
    private DateTime? filterTo;
    private int filterStadiumId;
    private string filterGroup = "";
    private Phase? filterPhase;

    private string FilterPhaseSelection
    {
        get => filterPhase?.ToString() ?? "";
        set => filterPhase = string.IsNullOrEmpty(value) ? null : Enum.Parse<Phase>(value);
    }

    private List<Match> matches = new();
    private IReadOnlyCollection<ProjectCopa.Stadium> stadiums = Array.Empty<ProjectCopa.Stadium>();
    
    private readonly List<string> errors = new();
    private string? successMessage;

    
    private int? editingMatchId;
    private DateTime editingMatchDate;
    private int editingStadiumId;
    private int editingHomeGoals;
    private int editingAwayGoals;

    protected override void OnInitialized()
    {
        LoadStadiums();
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        errors.Clear();
        successMessage = null;
        matches.Clear();
        CancelEdit();

        try
        {
            IEnumerable<Match> result = MatchRepository.GetAll()
                .Concat(EliminationRepository.GetAll());

            if (filterFrom.HasValue)
            {
                DateTime fromDate = filterFrom.Value.Date;
                result = result.Where(m => m.MatchDate.Date >= fromDate);
            }

            if (filterTo.HasValue)
            {
                DateTime toDateExclusive = filterTo.Value.Date.AddDays(1);
                result = result.Where(m => m.MatchDate < toDateExclusive);
            }

            if (filterStadiumId > 0)
                result = result.Where(m => m.Stadium != null && m.Stadium.Id == filterStadiumId);

            if (!string.IsNullOrEmpty(filterGroup))
                result = result.Where(m => m is MatchGroup mg && mg.Group != null && mg.Group.Name == filterGroup);

            if (filterPhase.HasValue)
                result = result.Where(m => m is MatchElimination me && me.Phase == filterPhase.Value);

            matches = result.ToList();
        }
        catch (ArgumentException ex)
        {
            errors.Add(ex.Message);
        }
        catch (Exception ex)
        {
            errors.Add("Error al filtrar: " + ex.Message);
        }
    }

    private void ClearFilters()
    {
        filterFrom = null;
        filterTo = null;
        filterStadiumId = 0;
        filterGroup = "";
        filterPhase = null;
        ApplyFilters();
    }

    private void LoadStadiums()
    {
        try
        {
            stadiums = StadiumServices.GetAllStadiums();
        }
        catch (StadiumServicesException ex)
        {
            errors.Add(ex.Message);
        }
        catch (ArgumentException ex)
        {
            errors.Add(ex.Message);
        }
    }

    private void StartEdit(Match match)
    {
        errors.Clear();
        successMessage = null;
        
        editingMatchId = match.MatchId;
        editingMatchDate = match.MatchDate;
        editingStadiumId = match.Stadium?.Id ?? 0;
        editingHomeGoals = match.HomeGoals;
        editingAwayGoals = match.AwayGoals;
    }

    private void CancelEdit()
    {
        editingMatchId = null;
        editingMatchDate = default;
        editingStadiumId = 0;
        editingHomeGoals = 0;
        editingAwayGoals = 0;
    }

    private void SaveEdit(Match match)
    {
        errors.Clear();
        successMessage = null;

        if (!ValidateEdit())
            return;

        try
        {
            UpdateMatch(match);
            PersistChanges();
            
            successMessage = "Partido actualizado correctamente";
            CancelEdit();
            ApplyFilters();
        }
        catch (ArgumentException ex)
        {
            errors.Add(ex.Message);
        }
        catch (Exception ex)
        {
            errors.Add("Error al actualizar el partido: " + ex.Message);
        }
    }

    private void UpdateMatch(Match match)
    {
        
        match.ChangeDate(editingMatchDate);

        
        match.SetGoals(editingHomeGoals, editingAwayGoals);

        
        if (editingStadiumId > 0)
        {
            ProjectCopa.Stadium selectedStadium = StadiumServices.GetById(editingStadiumId);
            match.ChangeStadium(selectedStadium);
        }
    }

    private void PersistChanges()
    {
        Match edited = FindEditingMatch();
        if (edited is MatchElimination)
            EliminationRepository.Update(edited);
        else
            MatchRepository.Update(edited);
        UnitOfWork.Commit();
    }

    private Match FindEditingMatch()
    {
        return matches.First(m => m.MatchId == editingMatchId);
    }

    private bool ValidateEdit()
    {
        if (editingMatchDate == default)
        {
            errors.Add("La fecha es obligatoria");
        }

        if (editingStadiumId <= 0)
        {
            errors.Add("Debe seleccionar un estadio");
        }

        if (editingHomeGoals < 0 || editingAwayGoals < 0)
        {
            errors.Add("Los goles no pueden ser negativos");
        }

        return !errors.Any();
    }

    private void GoToLogin()
    {
        Nav.NavigateTo("/login");
    }
}
