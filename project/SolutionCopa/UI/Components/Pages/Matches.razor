@page "/matches"
@using ProjectCopa
@using Services
@using Services.Exceptions
@using Services.Interfaces
@using UI
@using DataAccess.Interfaces
@inject IMatchRepository MatchRepository
@inject IUnitOfWork UnitOfWork
@inject IStadiumService StadiumServices
@inject SessionState Session
@inject NavigationManager Nav

<PageTitle>Partidos</PageTitle>

<h3>Partidos - Fase de Grupos</h3>

@if (!Session.IsLoggedIn)
{
    <p>No estás logueado</p>
    <button @onclick="GoToLogin">Ir a Login</button>
}
else
{
    @if (errors.Any())
    {
        <ul style="color:red">
            @foreach (var error in errors)
            {
                <li>@error</li>
            }
        </ul>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <p style="color:green">@successMessage</p>
    }

    <div class="filters">
        <label>Desde:</label>
        <input type="date" @bind="filterFrom" />

        <label>Hasta:</label>
        <input type="date" @bind="filterTo" />

        <label>Estadio:</label>
        <select @bind="filterStadiumId">
            <option value="0">-- Todos --</option>
            @foreach (ProjectCopa.Stadium s in stadiums)
            {
                <option value="@s.Id">@s.Name</option>
            }
        </select>

        <label>Grupo:</label>
        <select @bind="filterGroup">
            <option value="">-- Todos --</option>
            @foreach (string g in groupOptions)
            {
                <option value="@g">@g</option>
            }
        </select>

        <label>Fase:</label>
        <select @bind="filterPhase">
            <option value="">-- Todas --</option>
            @foreach (Phase p in Enum.GetValues<Phase>())
            {
                <option value="@p">@p</option>
            }
        </select>

        <button @onclick="ApplyFilters">Filtrar</button>
        <button @onclick="ClearFilters">Limpiar</button>
    </div>

    <hr />

    @if (matches.Any())
    {
        <h4>Partidos filtrados</h4>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Fecha</th>
                    <th>Equipos</th>
                    <th>Estadio</th>
                    <th>Resultado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Match match in matches)
                {
                    @if (editingMatchId == match.MatchId)
                    {
                        <tr style="background-color: #fff3cd;">
                            <td>@match.MatchId</td>
                            <td>
                                <input type="datetime-local" @bind="editingMatchDate" />
                            </td>
                            <td>
                                @match.HomeTeam?.Name vs @match.AwayTeam?.Name
                            </td>
                            <td>
                                <select @bind="editingStadiumId">
                                    <option value="0">-- Seleccione estadio --</option>
                                    @foreach (var stadium in stadiums)
                                    {
                                        <option value="@stadium.Id">@stadium.Name</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <input type="number" @bind="editingHomeGoals" min="0" style="width: 40px;" />
                                -
                                <input type="number" @bind="editingAwayGoals" min="0" style="width: 40px;" />
                            </td>
                            
                            <td>
                                <button @onclick="() => SaveEdit(match)">Guardar</button>
                                <button @onclick="CancelEdit">Cancelar</button>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td>@match.MatchId</td>
                            <td>@match.MatchDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@match.HomeTeam?.Name vs @match.AwayTeam?.Name</td>
                            <td>@match.Stadium?.Name</td>
                            <td>@match.HomeGoals - @match.AwayGoals</td>
                            
                            <td>
                                <button @onclick="() => StartEdit(match)">Editar</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No hay partidos para los filtros seleccionados</p>
    }
}

@code {
    private static readonly string[] groupOptions =
        Enumerable.Range(0, 12).Select(i => ((char)('A' + i)).ToString()).ToArray();

    private DateTime? filterFrom;
    private DateTime? filterTo;
    private int filterStadiumId;
    private string filterGroup = "";
    private Phase? filterPhase;

    private List<Match> matches = new();
    private IReadOnlyCollection<ProjectCopa.Stadium> stadiums = Array.Empty<ProjectCopa.Stadium>();
    
    private readonly List<string> errors = new();
    private string? successMessage;

    
    private int? editingMatchId;
    private DateTime editingMatchDate;
    private int editingStadiumId;
    private int editingHomeGoals;
    private int editingAwayGoals;

    protected override void OnInitialized()
    {
        LoadStadiums();
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        errors.Clear();
        successMessage = null;
        matches.Clear();
        CancelEdit();

        try
        {
            IEnumerable<Match> result = MatchRepository.GetAll();

            if (filterFrom.HasValue && filterTo.HasValue)
                result = result.Where(m => m.MatchDate >= filterFrom && m.MatchDate <= filterTo);
            else if (filterFrom.HasValue)
                result = result.Where(m => m.MatchDate >= filterFrom);
            else if (filterTo.HasValue)
                result = result.Where(m => m.MatchDate <= filterTo);

            if (filterStadiumId > 0)
                result = result.Where(m => m.Stadium != null && m.Stadium.Id == filterStadiumId);

            if (!string.IsNullOrEmpty(filterGroup))
                result = result.OfType<MatchGroup>()
                    .Where(m => m.Group != null && m.Group.Name == filterGroup)
                    .Cast<Match>();

            if (filterPhase.HasValue)
                result = result.OfType<MatchElimination>()
                    .Where(m => m.Phase == filterPhase.Value)
                    .Cast<Match>();

            matches = result.ToList();
        }
        catch (ArgumentException ex)
        {
            errors.Add(ex.Message);
        }
        catch (Exception ex)
        {
            errors.Add("Error al filtrar: " + ex.Message);
        }
    }

    private void ClearFilters()
    {
        filterFrom = null;
        filterTo = null;
        filterStadiumId = 0;
        filterGroup = "";
        filterPhase = null;
        ApplyFilters();
    }

    private void LoadStadiums()
    {
        try
        {
            stadiums = StadiumServices.GetAllStadiums();
        }
        catch (StadiumServicesException ex)
        {
            errors.Add(ex.Message);
        }
        catch (ArgumentException ex)
        {
            errors.Add(ex.Message);
        }
    }

    private void StartEdit(Match match)
    {
        errors.Clear();
        successMessage = null;
        
        editingMatchId = match.MatchId;
        editingMatchDate = match.MatchDate;
        editingStadiumId = match.Stadium?.Id ?? 0;
        editingHomeGoals = match.HomeGoals;
        editingAwayGoals = match.AwayGoals;
    }

    private void CancelEdit()
    {
        editingMatchId = null;
        editingMatchDate = default;
        editingStadiumId = 0;
        editingHomeGoals = 0;
        editingAwayGoals = 0;
    }

    private void SaveEdit(Match match)
    {
        errors.Clear();
        successMessage = null;

        if (!ValidateEdit())
            return;

        try
        {
            UpdateMatch(match);
            PersistChanges();
            
            successMessage = "Partido actualizado correctamente";
            CancelEdit();
            ApplyFilters();
        }
        catch (ArgumentException ex)
        {
            errors.Add(ex.Message);
        }
        catch (Exception ex)
        {
            errors.Add("Error al actualizar el partido: " + ex.Message);
        }
    }

    private void UpdateMatch(Match match)
    {
        
        match.ChangeDate(editingMatchDate);

        
        match.SetGoals(editingHomeGoals, editingAwayGoals);

        
        if (editingStadiumId > 0)
        {
            ProjectCopa.Stadium selectedStadium = StadiumServices.GetById(editingStadiumId);
            match.ChangeStadium(selectedStadium);
        }
    }

    private void PersistChanges()
    {
        MatchRepository.Update(match: FindEditingMatch());
        UnitOfWork.Commit();
    }

    private Match FindEditingMatch()
    {
        return matches.First(m => m.MatchId == editingMatchId);
    }

    private bool ValidateEdit()
    {
        if (editingMatchDate == default)
        {
            errors.Add("La fecha es obligatoria");
        }

        if (editingStadiumId <= 0)
        {
            errors.Add("Debe seleccionar un estadio");
        }

        if (editingHomeGoals < 0 || editingAwayGoals < 0)
        {
            errors.Add("Los goles no pueden ser negativos");
        }

        return !errors.Any();
    }

    private void GoToLogin()
    {
        Nav.NavigateTo("/login");
    }
}
