
@page "/teams"
@using ProjectCopa
@using Services
@using Services.Exceptions
@inject TeamServices TeamServices
@inject SessionState Session
@inject NavigationManager Nav

<PageTitle>Equipos</PageTitle>

@if (!Session.IsLoggedIn)
{
    <section class="m26-card auth-card">
        <h1 class="m26-page-title mb-2">Equipos</h1>
        <p class="mb-3">No estás logueado.</p>
        <button class="btn btn-primary" @onclick="GoToLogin">
            <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
            Ir a Login
        </button>
    </section>
}
else if (!IsAdmin)
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
        No tenés permisos para administrar equipos.
    </div>
}
else
{
    <h1 class="m26-page-title">Equipos</h1>

    if (errors.Any())
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            Se encontraron errores:
            <ul>
                @foreach (string error in errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success" role="alert">
            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
            @successMessage
        </div>
    }

    <section class="admin-grid">
        <article class="m26-card pane">
            <h2 class="pane-title">Crear equipo</h2>
            <div class="mb-3">
                <label class="form-label" for="teamName">Nombre</label>
                <input id="teamName" class="form-control" placeholder="Nombre" @bind="nombre" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="teamRanking">Ranking FIFA</label>
                <input id="teamRanking" class="form-control" placeholder="Ranking FIFA" type="number" @bind="rankingFifa" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="teamConfederation">Confederación</label>
                <select id="teamConfederation" class="form-select" @bind="confederation">
                    @foreach (Confederation c in Enum.GetValues<Confederation>())
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </div>

            <button class="btn btn-primary" @onclick="Create">
                <i class="bi bi-plus-circle-fill" aria-hidden="true"></i>
                Crear
            </button>
        </article>

        <article class="m26-card pane">
            <h2 class="pane-title">Equipos existentes</h2>
            @if (!equipos.Any())
            {
                <div class="m26-empty">
                    <i class="bi bi-people" aria-hidden="true"></i>
                    <p class="mb-0">No hay equipos cargados.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover m26-scoreboard mb-0">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Ranking</th>
                                <th>Confederación</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (Team equipo in equipos)
                            {
                                <tr>
                                    <td>@equipo.Name</td>
                                    <td>@equipo.FifaRanking</td>
                                    <td>
                                        <span class="m26-conf-badge conf-@equipo.Confederation">@equipo.Confederation</span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => Remove(equipo.Name)">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                            Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </article>
    </section>
}

@code {
    private string nombre = "";
    private int rankingFifa;
    private Confederation confederation;

    private readonly List<string> errors = new List<string>();
    private string? successMessage;

    private IReadOnlyCollection<Team> equipos = Array.Empty<Team>();

    private bool IsAdmin =>
        Session.CurrentUser!.Roles.Contains(UserRoles.Admin);

    protected override void OnInitialized()
    {
        LoadTeams();
    }

    private void LoadTeams()
    {
            equipos = TeamServices.GetTeams();
    }

    private void Create()
    {
        errors.Clear();
        successMessage = null;

        if (!ValidateInput())
            return;

        try
        {
            int nextId = TeamServices.GetTeams().Select(t => t.Id).DefaultIfEmpty(0).Max() + 1;
            Team team = new Team(nextId, nombre, rankingFifa, false, confederation);
            TeamServices.AddTeam(team);
            successMessage = "Equipo creado correctamente";
            ClearForm();
            LoadTeams();
        }
        catch (TeamServicesException ex)
        {
            errors.Add(ex.Message);
        }
        catch (ArgumentException ex)
        {
            errors.Add(ex.Message);
        }
    }

    private void Remove(string nombreEquipo)
    {
        errors.Clear();
        successMessage = null;

        try
        {
            TeamServices.RemoveTeam(nombreEquipo);
            successMessage = "Equipo eliminado correctamente";
            LoadTeams();
        }
        catch (TeamServicesException ex)
        {
            errors.Add(ex.Message);
        }
    }

    private bool ValidateInput()
    {
        if (string.IsNullOrWhiteSpace(nombre))
            errors.Add("El nombre es obligatorio");

        if (rankingFifa < 300 || rankingFifa > 2500)
            errors.Add("El ranking FIFA debe estar entre 300 y 2500");

        return !errors.Any();
    }

    private void ClearForm()
    {
        nombre = "";
        rankingFifa = 0;
        confederation = default;
    }

    private void GoToLogin()
    {
        Nav.NavigateTo("/login");
    }
}
