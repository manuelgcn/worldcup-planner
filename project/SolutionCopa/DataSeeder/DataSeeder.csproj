<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>DataSeeder</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Domain\Domain.csproj" />
        <ProjectReference Include="..\Services\Services.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.*" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.*" />
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.*" />
    </ItemGroup>

    <!-- Datos de apoyo: el CSV oficial de 48 equipos y las banderas reales. -->
    <ItemGroup>
        <Content Include="..\..\..\teams-wc2026-48.csv" Link="data\teams-wc2026-48.csv" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="..\..\..\flags-master\**" Link="flags-master\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
